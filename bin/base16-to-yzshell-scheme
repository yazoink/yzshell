#!/usr/bin/env python
# base16-to-yzshell colourscheme converter

import json
from argparse import ArgumentParser
from os import path, environ
from sys import argv, exit
import yaml

from sys import path as sys_path

sys_path.append(environ["YZSHELL_PYTHON_LIB_DIR"])
from tuiutils import announce, print_err, confirm
from miscutils import get_full_path


def convert(src, dest, polarity):
    src = get_full_path(src)
    base16 = None
    yzshell = {}
    conv_map = {
        "scheme": "scheme",
        "author": "author",
        "base00": "background",
        "base05": "foreground",
        "base08": "red",
        "base09": "orange",
        "base0A": "yellow",
        "base0B": "green",
        "base0C": "cyan",
        "base0D": "blue",
        "base0E": "purple",
        "base0F": "brown",
    }

    if path.isfile(src) == False:
        print_err(f"File '{src}' not found!")
        exit(1)

    if polarity not in ["dark", "light"]:
        print_err("Polarity must be either 'dark' or 'light'.")
        exit(1)

    if dest == None:
        n = path.basename(src).replace(".yml", "").replace(".yaml", "")
        n = "".join([char for char in n if char.isalnum()])
        dest = f"{n}.json"

    with open(src, "r") as f:
        base16 = yaml.load(f, Loader=yaml.FullLoader)

    for c in conv_map:
        yzshell[conv_map[c]] = base16[c]

    yzshell["polarity"] = polarity

    if path.isfile(dest):
        if confirm(f"File '{dest}' already exists, overwrite?"):
            break
        else:
            announce("Operation cancelled, exiting.")
            exit(1)

    try:
        with open(dest, "w") as f:
            json.dump(yzshell, f)
    except OSError:
        print_err(f"Could not write to file '{dest}'!")
        exit(1)

    announce(f"Converted scheme saved to '{dest}'!")


def main():
    parser = ArgumentParser()
    parser.add_argument("-s", "--source")
    parser.add_argument("-d", "--dest", default=None)
    parser.add_argument("-l", "--polarity", default="dark")
    args = parser.parse_args(argv[1:])
    convert(args.source, args.dest, args.polarity)


main()
