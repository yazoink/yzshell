#!/usr/bin/env python
# base16-to-yzshell template converter

from argparse import ArgumentParser
from os import path
from sys import argv, exit, environ
from sys import path as sys_path

sys_path.append(environ["YZSHELL_PYTHON_LIB_DIR"])
from tuiutils import announce, print_err, confirm
from miscutils import get_full_path


def convert(src, dest):
    conv_map = {
        "base00": "background",
        "base01": "surface1",
        "base02": "surface2",
        "base03": "surface3",
        "base04": "surface4",
        "base05": "foreground",
        "base06": "foreground",
        "base07": "foreground",
        "base08": "red",
        "base09": "orange",
        "base0A": "yellow",
        "base0B": "green",
        "base0C": "cyan",
        "base0D": "blue",
        "base0E": "purple",
        "base0F": "brown",
        "scheme-name": "scheme",
        "scheme-author": "author",
        "scheme-slug": "id",
    }
    src = get_full_path(src)
    src_file = path.basename(src)
    data = None

    if dest == None:
        dest = f"yzshell-{src_file}"

    if path.isfile(src) == False:
        print_err(f"File '{src}' not found!")
        exit(1)

    with open(src, "r") as f:
        data = f.read()

    for c in conv_map:
        data = data.replace(c, conv_map[c])

    if path.isfile(dest):
        if confirm(f"File '{dest}' already exists, overwrite?"):
            break
        else:
            announce("Operation cancelled, exiting.")
            exit(1)

    try:
        with open(dest, "w") as f:
            f.write(data)
    except OSError:
        print_err(f"Could not write to file '{dest}'!")
        exit(1)

    announce(f"Converted template saved to '{dest}'!")


def main():
    parser = ArgumentParser()
    parser.add_argument("-s", "--source")
    parser.add_argument("-d", "--dest", default=None)
    args = parser.parse_args(argv[1:])
    announce(
        "Note: yzshell does not support decimal or hsl colours -- these values must be manually configured!"
    )
    convert(args.source, args.dest)


main()
