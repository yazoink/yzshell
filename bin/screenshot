#!/usr/bin/env bash

type="full"
dir="$(yzshell config get_option screenshot_dir)"
file="${dir}/$(date +%Y%m%d_%H:%M:%S_screenshot).png"
sleep=0

while getopts 'm:s:o:' OPTION; do
  case "$OPTION" in
    m)
        echo "$OPTARG"
        case "$OPTARG" in
            "select" | "full" ) type="$OPTARG" ;;
            * )
                echo "Error: invalid argument provided to '-t'" >&2
                exit 1
                ;;
        esac
        ;;
    s) sleep=$OPTARG ;;
    o)
        file="$OPTARG"
        dir="$(basename "$file")"
        ;;
    ?)
      echo "usage: $(basename \$0) [-m select|full] [-s <sleep time>] [-o /path/to/output.png]" >&2
      exit 1
      ;;
  esac
done
shift "$(($OPTIND -1))"

[ ! -d "$dir" ] && mkdir -p "$dir"

sleep $sleep

case "$type" in
    "full") grim "$file" ;;
    "select") grim -g "$(slurp)" "$file" ;;
esac

[ $? -eq 0 ] && notify-send -i "$file" "Screenshot saved" "$file"