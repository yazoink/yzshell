#!/usr/bin/env python

from shutil import copytree, rmtree
import json
import subprocess
from os import environ, listdir, makedirs, path, remove
from shutil import copyfile, copytree
from sys import argv, exit
from sys import path as sys_path
from sys import stderr

sys_path.append(environ["YZSHELL_PYTHON_LIB_DIR"])
from configutils import (
    get_colourscheme,
    get_config,
    get_default_config,
    get_mustache_data,
    set_config_option,
    write_config,
)
from miscutils import delete_if_exists


def parse_json_file(p):
    with open(p, "r") as f:
        return json.load(f)


def write_json_file(content, p):
    with open(p, "w") as f:
        f.write(json.dumps(content, indent=4))


def backup(f):
    if path.exists(f) == True:
        if path.isdir(f):
            copytree(f, f + "-old")
        else:
            if path.islink(f) == False:
                copyfile(f, f + ".bak")
    subprocess.run(f"rm -rf '{f}'", shell=True)


def deploy_templates(data, sch_dir):
    import chevron

    def delete_existing(dest):
        home_dest = path.join(environ["HOME"], dest)
        backup(home_dest)

    def copy_template(dest, b):
        with open(dest, "w") as f:
            f.write(b)

    def ensure_dir(dir):
        if path.exists(dir) == False:
            makedirs(dir)

    templates_file = path.join(environ["YZSHELL_TEMPLATES_DIR"], "templates.json")
    templates = parse_json_file(templates_file)

    if path.exists(sch_dir) == False:
        makedirs(sch_dir)
        buf = None
        for t in templates:
            with open(path.join(environ["YZSHELL_TEMPLATES_DIR"], t), "r") as f:
                buf = chevron.render(f, data)
            if type(templates[t]) == list:
                for d in templates[t]:
                    dest = path.join(sch_dir, d)
                    delete_existing(d)
                    ensure_dir(path.dirname(dest))
                    copy_template(dest, buf)
            else:
                dest = path.join(sch_dir, templates[t])
                delete_existing(templates[t])
                ensure_dir(path.dirname(dest))
                copy_template(dest, buf)
    else:
        for t in templates:
            if type(templates[t]) == list:
                for d in templates[t]:
                    delete_existing(d)
            else:
                delete_existing(templates[t])
    r = subprocess.run(
        f"""
        stow \
            --no-folding \
            --target='{environ["HOME"]}' \
            --dir='{sch_dir}' \
            -R .
        """,
        shell=True,
    )
    if r.returncode != 0:
        print("Error: could not stow dotfiles, please fix any conflicts.")
        exit(1)

def copy_static_dots():
    def get_dirs(dir):
        files = []
        dir_list = listdir(dir)
        for d in dir_list:
            full_path = path.join(dir, d)
            if path.isfile(full_path):
                files.append(full_path)
            else:
                files = files + get_dirs(full_path)
        return files

    src_dir = path.join(environ["YZSHELL_DATA_DIR"], "dotfiles")
    files = get_dirs(src_dir)

    for file in files:
        dir = path.dirname(file)
        if path.exists(dir) == False:
            makedirs(dir)
        src = file
        dest = path.expanduser(file.replace(src_dir, "~"))
        delete_if_exists(dest)
        copyfile(src, dest)



def deploy_configs(cfg, copy_static=True):
    from shutil import copytree

    extra_conf_files = {
        "hyprland-extra.lua": ".config/hypr/hyprland/extra.lua",
        "nvim-extra.lua": ".config/nvim/extra.lua",
    }
    ensure = [
        path.expanduser("~/.config"),
        path.expanduser("~/.oh-my-zsh/custom"),
    ]

    sch = get_colourscheme(cfg["colourscheme"])
    sch_dir = path.join(environ["YZSHELL_TEMPLATE_CACHE_DIR"], cfg["colourscheme"])
    data = get_mustache_data(cfg, sch)
    deploy_templates(data, sch_dir)

    # ensure dirs are not symlinks
    for d in ensure:
        if path.islink(d):
            subprocess.run(f"rm -f {d}", shell=True)
        if path.exists(d) == False:
            makedirs(d)

    if copy_static == True:
        copy_static_dots()

    for c in extra_conf_files:
        src = path.join(environ["YZSHELL_CONF_DIR"], c)
        dest = path.join(environ["HOME"], extra_conf_files[c])
        delete_if_exists(dest)
        if path.isfile(src):
            try:
                copyfile(
                    src,
                    dest,
                )
            except:
                pass

    subprocess.Popen(
        f"""    
        gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3
        gsettings set org.gnome.desktop.interface font-name "sans 11"
        gsettings set org.gnome.desktop.interface color-scheme prefer-{data["polarity"]}
        gsettings set org.gnome.desktop.interface cursor-theme {data["cursor_theme"]}
        papirus-folders -C {data["papirus_folders_colour"]} --theme {data["icon_theme"]}
        gsettings set org.gnome.desktop.interface icon-theme {data["icon_theme"]}
        hyprctl setcursor {data["cursor_theme"]} 32
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )
    if cfg["web_browser"] == "zen-browser":
        subprocess.Popen(
            f"""
            zenconf \
                --unattended \
                --no-policies \
                --profile-dir '{cfg["zen_profile_dir"]}'
            """,
            shell=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.STDOUT,
        )


def toggle_dotfiles_off(app):
    # templates
    if "templates" in app:
        templates_file = path.join(environ["YZSHELL_TEMPLATES_DIR"], "templates.json")
        all_templates = parse_json_file(templates_file)
        for t in app["templates"]:
            all_templates.pop(t)
            target = path.join(
                environ["HOME"], 
                app["templates"][t]
            )
            target_dir = path.dirname(target)
            remove(target)
        write_json_file(all_templates, templates_file)

    # static
    if "static_configs" in app:
        for c in app["static_configs"]:
            target = path.join(
                environ["HOME"], 
                app["static_configs"][c]
            )
        delete_if_exists(target)


def toggle_dotfiles_on(app):
    # static
    if "static_configs" in app:
        for c in app["static_configs"]:
            src = path.join(
                environ["YZSHELL_DATA_DIR"], 
                "misc/optional-dotfiles",
                c
            )
            target = path.join(
                environ["HOME"], 
                app["static_configs"][c]
            )

            backup(target)

            dir = path.dirname(target)
            if path.exists(dir) == False:
                makedirs(dir)

            if path.isdir(target) == True:
                copytree(src, target)
            else:
                copyfile(src, target)

    # templates
    if "templates" in app:
        templates_file = path.join(environ["YZSHELL_TEMPLATES_DIR"], "templates.json")
        all_templates = parse_json_file(templates_file)

        for t in app["templates"]:
            all_templates[t] = app["templates"][t]

        write_json_file(all_templates, templates_file)



def help(exitcode=0):
    print("""usage: yzconf <OPTION> ...
    Options:
        colourscheme <ACTION|SCHEME>: set the colourscheme
            Actions:
                list: list all available schemes
        wallpaper <OPTION> ...: set the wallpaper
            Options:
                mode <MODE>: sets the wallpaper mode
                    Modes:
                        stretch
                        fit
                        fill
                        center
                        tile
                image <PATH>: sets the wallpaper image
        deploy_configs [FLAGS]: generates and copies dotfiles
            Flags:
                --refresh | -r: removes and re-creates all configs
                --skip-static | -s: skips copying of static configs
        set <OPTION> <VALUE>: sets yzshell config option
        get [defaults] [OPTION]: 
            Sets yzshell config value -- 'yzshell get defaults' will get
            options from the default config. The command will return the entire
            configuration unless a specific option is provided.
        make_scheme <SCHEME>: creates and caches configs for colourscheme
        make_all_schemes: creates and caches configs for all colourschemes
        dump_mustache_data: dump data used to build configs
    """)
    exit(exitcode)


if __name__ == "__main__":
    argc = len(argv)
    cfg = get_config()
    if argc > 1:
        match argv[1]:
            case "colourscheme":
                if argc > 2:
                    if argv[2] == "list":
                        schemes = sorted(listdir(environ["YZSHELL_COLOURS_DIR"]))
                        for s in schemes:
                            print(s.replace(".json", ""))
                        exit(0)
                    file = path.join(environ["YZSHELL_COLOURS_DIR"], f"{argv[2]}.json")
                    if path.isfile(file) == False:
                        print(f"Error: colourscheme '{argv[2]}' not found!")
                        exit(1)
                    cfg = set_config_option(cfg, "colourscheme", argv[2])
                    write_config(cfg)
                    deploy_configs(cfg, copy_static=False)
                    _ = subprocess.run(
                        ["yzshell", "reload", "--no-wallpaper"],
                        capture_output=True
                    )
            case "wallpaper":
                if argc > 3:
                    match argv[2]:
                        case "image":
                            from miscutils import get_full_path

                            p = get_full_path(argv[3])
                            if path.isfile(p) == False:
                                print(f"Error: file '{p}' not found!")
                                exit(1)
                            s = path.split(p)
                            cfg = set_config_option(cfg, "wallpaper_dir", s[0])
                            cfg = set_config_option(cfg, "wallpaper_image", s[1])
                            write_config(cfg)
                            subprocess.run(
                                f"""
                                eww update current_wallpaper='{p}'
                                python {environ["YZSHELL_EWW_DIR"]}/settings/scripts/schemes_background.py
                                yzwallpaper reload
                                """,
                                shell=True,
                            )
                        case "mode":
                            modes = ["stretch", "fit", "fill", "center", "tile"]
                            if argv[3] in modes:
                                cfg = set_config_option(cfg, "wallpaper_mode", argv[3])
                                write_config(cfg)
                                subprocess.run(
                                    f"""
                                eww update wallpaper_mode='{argv[3]}'
                                yzwallpaper kill
                                yzwallpaper
                                """,
                                    shell=True,
                                )
                            else:
                                print(f"Error: invalid mode '{argv[3]}'", file=stderr)
            case "deploy_configs":
                copy_static = True
                if argc > 2:
                    if "--refresh" in argv or "-r" in argv:
                        delete_if_exists(environ["YZSHELL_STOW_DIR"])
                        delete_if_exists(environ["YZSHELL_TEMPLATE_CACHE_DIR"])
                    if "--skip-static" in argv or "-s" in argv:
                        copy_static = False
                deploy_configs(cfg, copy_static)
            case "set":
                if argc > 3:
                    opt = argv[2]
                    val = argv[3]
                    toggleable_dotfiles = [
                        {
                            "option": "configure_vscodium",
                            "templates": {
                                "vscode.json.mustache": ".config/Code - OSS/User/settings.json"
                            }
                        },
                        {
                            "option": "configure_nvim",
                            "static_configs": {
                                "nvim": ".config/nvim"
                            },
                            "templates": {
                                "nvim.lua.mustache": ".config/nvim/plugin/colourscheme.lua"
                            }
                        },
                        {
                            "option": "configure_vesktop",
                            "static_configs": {
                                "vesktop": ".config/vesktop/settings.json"
                            },
                            "templates": {
                                "discord.css.mustache": ".config/vesktop/themes/yzshell.theme.css"
                            }
                        },
                    ]

                    if val.lower() == "true":
                        val = True
                    elif val.lower() == "false":
                        val = False

                    if cfg[opt] == val:
                        exit(0)

                    for t in toggleable_dotfiles:
                        if opt == t["option"]:
                            if val == True:
                                toggle_dotfiles_on(t)
                            elif val == False:
                                toggle_dotfiles_off(t)
                            else:
                                print("Error: invalid value")
                                exit(1)

                    cfg = set_config_option(cfg, opt, val)
                    write_config(cfg)
            case "get":
                if argc > 2:
                    if argv[2] == "defaults":
                        defaults = get_default_config()
                        if argc < 4:
                            print(json.dumps(defaults, indent=4))
                        else:
                            if argv[3] in defaults:
                                val = defaults[argv[3]]
                                if type(val) == bool:
                                    val = str(val).lower()
                                print(val)
                            else:
                                print(
                                    f"Error: invalid config option '{argv[2]}'",
                                    file=stderr,
                                )
                    else:
                        if argv[2] in cfg:
                            val = cfg[argv[2]]
                            if type(val) == bool:
                                val = str(val).lower()
                            print(val)
                        else:
                            print(
                                f"Error: invalid config option '{argv[2]}'", file=stderr
                            )
                else:
                    print(json.dumps(cfg, indent=4))
            case "make_scheme":
                if argv > 2:
                    sch = get_colourscheme(argv[2])
                    make_templates(cfg, sch)
            case "make_all_schemes":
                schemes = listdir(environ["YZSHELL_COLOURS_DIR"])
                for s in schemes:
                    sch = get_colourscheme(s.replace(".json", ""))
                    make_templates(cfg, sch)
            case "dump_mustache_data":
                sch = get_colourscheme(cfg["colourscheme"])
                data = get_mustache_data(cfg, sch)
                print(json.dumps(data, indent=4))
            case _:
                help()