#!/usr/bin/env python

import json
import subprocess
from os import listdir, makedirs, path, remove, unlink
from shutil import rmtree
from sys import argv, exit, stderr

CONFIG_DIR = path.expanduser("~/.config")
STOW_DIR = path.expanduser("~/.dotfiles")
YZSHELL_CONFIG_DIR = path.join(CONFIG_DIR, "yzshell")
CONFIG_FILE = path.join(YZSHELL_CONFIG_DIR, "config.json")
DATA_DIR = path.expanduser("~/.local/share/yzshell")
COLOURS_DIR = path.join(DATA_DIR, "colourschemes")
BUILT_TEMPLATE_DIR = path.expanduser("~/.cache/yzshell/built_templates")
TEMPLATES_DIR = path.join(DATA_DIR, "templates")

def get_default_config():
    with open(path.join(DATA_DIR, "misc/default-config.json"), "r") as f:
        return json.load(f)
    # NOTE:
    # Commenting here instead of the file since json doesn't support comments 
    # lol
    #
    # Other good mono fonts aside from default
    # - M+1Code Nerd Font Mono (ttf-mplus-nerd)
    # - Monofur Nerd Font (ttf-monofur-nerd)

def get_config():
    current = get_default_config()
    if path.isfile(CONFIG_FILE):
        buf = None
        with open(CONFIG_FILE, "r") as f:
            buf = f.read()
        try:
            user_config = json.loads(buf)
            for c in user_config:
                current[c] = user_config[c]
        except json.JSONDecodeError as e:
            print("Warning: could not parse yzshell config, please check for errors. Falling back to default...", e)
    return current


def get_colourscheme(name):
    def hex_to_rgb(hex_colour):
        return tuple(int(hex_colour[i : i + 2], 16) for i in (0, 2, 4))

    def rgb_to_hex(rgb):
        return "{:02X}{:02X}{:02X}".format(int(rgb[0]), int(rgb[1]), int(rgb[2]))
        
    def overlay_colour(base, overlay, amount):
        base = hex_to_rgb(base)
        overlay = hex_to_rgb(overlay)
        r = base[0] + (overlay[0] - base[0]) * amount
        g = base[1] + (overlay[1] - base[1]) * amount
        b = base[2] + (overlay[2] - base[2]) * amount
        return rgb_to_hex((r, g, b))

    #schemes = listdir(COLOURS_DIR)
    cols = [
        "background",
        "foreground",
        "surface1",
        "surface2",
        "surface3",
        "surface4",
        "red",
        "orange",
        "yellow",
        "green",
        "cyan",
        "blue",
        "purple",
        "brown",
        "accent"
    ]
    scheme_file = path.join(COLOURS_DIR, f"{name}.json")
    scheme = None
    buf = None
    window_buttons = ["red", "yellow", "green"]
    accent = "blue"

    if path.isfile(scheme_file) == False:
        print(f"Error: colourscheme '{name}' not found", file=stderr)
        exit(1)

    with open(scheme_file, "r") as f:
        buf = f.read()
    try:
        scheme = json.loads(buf)
    except json.JSONDecodeError as e:
        print(f"Error: could not load colourscheme at '{scheme_file}'", file=stderr)
        exit(1)

    for i in range(1, 5):
        scheme[f"surface{i}"] = overlay_colour(scheme["background"], scheme["foreground"], i / 10)

    if "window_buttons" in scheme:
        window_buttons = scheme["window_buttons"]
    else:
        window_buttons = ["red", "yellow", "green"]
    if "accent" in scheme:
        accent = scheme["accent"]
    scheme["window_button1"] = scheme[window_buttons[0]]
    scheme["window_button2"] = scheme[window_buttons[1]]
    scheme["window_button3"] = scheme[window_buttons[2]]
    scheme["accent"] = scheme[accent]

    for c in cols:
        d = scheme[c]
        rgb = hex_to_rgb(d)
        scheme[f"{c}-rgb-r"] = rgb[0]
        scheme[f"{c}-rgb-g"] = rgb[1]
        scheme[f"{c}-rgb-b"] = rgb[2]
        scheme[f"{c}-hex"] = f"#{d}"
        scheme[f"{c}-bgr-hex"] = f"{d[4]}{d[5]}{d[2]}{d[3]}{d[0]}{d[1]}"
    return scheme

def copy_built_templates(scheme_dir, templates):
    from os import remove
    from shutil import copyfile
    def copy_template(src_file, dest_file):
        dest = path.join(STOW_DIR, dest_file)
        d = path.split(dest)[0] # directory
        if path.isfile(dest):
            remove(dest)
        elif path.exists(d) == False:
            makedirs(d)      
        copyfile(path.join(scheme_dir, src_file), dest) # ~/.dotfiles/<config>
    for t in templates:
        if type(templates[t]) == list:
            for i in templates[t]:
                copy_template(t, i)
        else:
            copy_template(t, templates[t])


def merge_data(cfg, sch):
    data = cfg | sch
    data["prefer_dark_theme"] = "false"
    data["icon_theme"] = "Papirus"
    data["cursor_theme"] = "BreezeX"
    if sch["polarity"] == "dark":
        data["prefer_dark_theme"] = "true"
        data["icon_theme"] += "-Dark"
        data["cursor_theme"] += "-Dark"
    elif sch["polarity"] == "light":
        data["icon_theme"] += "-Light"
        data["cursor_theme"] += "-Light"
    return data


def get_templates():
    with open(path.join(TEMPLATES_DIR, "templates.json"), "r") as f:
        return json.load(f)


def make_templates(data, sch_dir, templates):
    import chevron
    if path.exists(sch_dir) == False:
        makedirs(sch_dir)
        buf = None
        for t in templates:
            with open(path.join(TEMPLATES_DIR, t), "r") as f:
                buf = chevron.render(f, data)
            with open(path.join(sch_dir, t), "w") as f:
                f.write(buf)


def set_option(cfg, opt, val):
    if opt not in cfg:
        print(f"Error: invalid configuration option '{opt}'", file=stderr)
        exit(1)
    cfg[opt] = val
    return cfg

def write_config(cfg):
    if path.exists(YZSHELL_CONFIG_DIR) == False:
        makedirs(YZSHELL_CONFIG_DIR)
    with open(CONFIG_FILE, "w") as f:
        f.write(json.dumps(cfg, indent=4))


def delete_if_exists(p):
    if path.isdir(p) == True:
        rmtree(p)
    elif path.isfile(p) == True:
        remove(p)
    elif path.islink(p) == True:
        unlink(p)


def deploy_configs(cfg):
    from shutil import copytree
    templates = get_templates()
    sch = get_colourscheme(cfg["colourscheme"])
    sch_dir = path.join(BUILT_TEMPLATE_DIR, cfg["colourscheme"])
    data = merge_data(cfg, sch)
    make_templates(data, sch_dir, templates)
    if path.exists(STOW_DIR) == False:
        copytree(path.join(DATA_DIR, "dotfiles"), STOW_DIR)
    copy_built_templates(sch_dir, templates)

    # additional config
    c = None
    s = path.join(DATA_DIR, "misc/waybar/config.jsonc")
    with open(s, "r") as f:
        buf = f.read()
        c = json.loads(buf)
    
    if data["bar_show_battery"] == True:
        c["group/quick-access"]["modules"].insert(3, "group/battery-expander")
    if data["bar_show_backlight"] == True:
        c["group/quick-access"]["modules"].insert(3, "group/backlight-expander")

    battery_name = "AC"
    bats = sorted(listdir("/sys/class/power_supply"))
    for b in bats:
        if b.startswith("BAT"):
            battery_name = b
            break
    c["battery#icon"]["bat"] = battery_name
    c["battery#percentage"]["bat"] = battery_name

    d = path.join(CONFIG_DIR, "waybar")

    if path.exists(d) == False:
        makedirs(d)

    with open(path.join(d, "config.jsonc"), "w") as f:
        f.write(json.dumps(c))

    if cfg["configure_vscodium"] == False:
        delete_if_exists(path.join(STOW_DIR, ".config/Code - OSS"))
    if cfg["configure_nvim"] == False:
        delete_if_exists(path.join(STOW_DIR, ".config/nvim"))
    if cfg["configure_vesktop"] == False:
        delete_if_exists(path.join(STOW_DIR, ".config/vesktop/settings.json"))
    if cfg["configure_zsh"] == False:
        delete_if_exists(path.join(STOW_DIR, ".zshrc"))
        delete_if_exists(path.join(STOW_DIR, ".oh-my-zsh"))

    subprocess.Popen(
        f'''
        stow --target='{path.expanduser("~")}' --dir='{STOW_DIR}' -R .
        gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3
        gsettings set org.gnome.desktop.interface font-name "sans 11"
        gsettings set org.gnome.desktop.interface color-scheme prefer-{data["polarity"]}
        gsettings set org.gnome.desktop.interface cursor-theme {data["cursor_theme"]}
        papirus-folders -C {data["papirus_folders_colour"]} --theme {data["icon_theme"]}
        gsettings set org.gnome.desktop.interface icon-theme {data["icon_theme"]}
        hyprctl setcursor {data["cursor_theme"]} 32
        ''',
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT
    )
    if cfg["web_browser"] == "zen-browser":
        subprocess.Popen(
            f'''
            zenconf \
                --unattended \
                --no-policies \
                --profile-dir '{cfg["zen_profile_dir"]}'
            ''', 
            shell=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.STDOUT
        )

def help(exitcode=0):
    print('''usage: yzconf <OPTION> ...
    Options:
        colourscheme <ACTION|SCHEME>: set the colourscheme
            Actions:
                list: list all available schemes
        wallpaper <OPTION> ...: set the wallpaper
            Options:
                mode <MODE>: sets the wallpaper mode
                    Modes:
                        stretch
                        fit
                        fill
                        center
                        tile
                image <PATH>: sets the wallpaper image
        deploy_configs [FLAGS]: generates and copies dotfiles
            Flags:
                --refresh | -r: removes and re-creates all configs
        set <OPTION> <VALUE>: sets yzshell config option
        get [defaults] [OPTION]: 
            Sets yzshell config value -- 'yzshell get defaults' will get
            options from the default config. The command will return the entire
            configuration unless a specific option is provided.
        make_scheme <SCHEME>: creates and caches configs for colourscheme
        make_all_schemes: creates and caches configs for all colourschemes
        dump_mustache_data: dump data used to build configs
    ''')
    exit(exitcode)

if __name__ == "__main__":
    argc = len(argv)
    cfg = get_config()
    if argc > 1:
        match argv[1]:
            case "colourscheme":
                if argc > 2:
                    if argv[2] == "list":
                        schemes = listdir(COLOURS_DIR)
                        for s in schemes:
                            print(s.replace(".json", ""))
                        exit(0)
                    file = path.join(COLOURS_DIR, f"{argv[2]}.json")
                    if path.isfile(file) == False:
                        print(f"Error: colourscheme '{argv[2]}' not found!")
                        exit(1)
                    cfg = set_option(cfg, "colourscheme", argv[2])
                    write_config(cfg)
                    deploy_configs(cfg)
                    subprocess.run(["yzshell", "reload", "--no-wallpaper"])
            case "wallpaper":
                if argc > 3:
                    match argv[2]:
                        case "image":
                            p = None
                            if "~" in argv[3]:
                                p = path.expanduser(argv[3])
                            else:
                                p = path.abspath(argv[3])
                            if path.isfile(p) == False:
                                print(f"Error: file '{p}' not found!")
                                exit(1)
                            s = path.split(p)
                            cfg = set_option(cfg, "wallpaper_dir", s[0])
                            cfg = set_option(cfg, "wallpaper_image", s[1])
                            write_config(cfg)
                            subprocess.run(
                                f'''
                                eww update current_wallpaper='{p}'
                                yzwallpaper reload
                                ''',
                                shell=True
                            )
                        case "mode":
                            modes = ["stretch", "fit", "fill", "center", "tile"]
                            if argv[3] in modes:
                                cfg = set_option(cfg, "wallpaper_mode", argv[3])
                                write_config(cfg)
                                subprocess.run(
                                f'''
                                eww update wallpaper_mode='{argv[3]}'
                                yzwallpaper kill
                                yzwallpaper
                                ''',
                                shell=True
                            )
                            else:
                                print(f"Error: invalid mode '{argv[3]}'", file=stderr)
            case "deploy_configs":
                if argc > 2:
                    if argv[2] in ["--refresh", "-r"]:
                        from shutil import rmtree
                        if path.exists(STOW_DIR):
                            rmtree(STOW_DIR)
                        if path.exists(BUILT_TEMPLATE_DIR):
                            rmtree(BUILT_TEMPLATE_DIR)
                deploy_configs(cfg)
            case "set":
                if argc > 3:
                    val = argv[3]
                    if val.lower() == "true":
                        val = True
                    elif val.lower() == "false":
                        val = False
                    cfg = set_option(cfg, argv[2], val)
                    write_config(cfg)
            case "get":
                if argc > 2:
                    if argv[2] == "defaults":
                        defaults = get_default_config()
                        if argc < 4:
                            print(json.dumps(defaults, indent=4))
                        else:
                            if argv[3] in defaults:
                                print(defaults[argv[3]])
                            else:
                                print(f"Error: invalid config option '{argv[2]}'", file=stderr)
                    else:
                        if argv[2] in cfg:
                            print(cfg[argv[2]])
                        else:
                            print(f"Error: invalid config option '{argv[2]}'", file=stderr)
                else:
                    print(json.dumps(cfg, indent=4))
            case "make_scheme":
                if argv > 2:
                    sch = get_colourscheme(argv[2])
                    make_templates(cfg, sch)
            case "make_all_schemes":
                schemes = listdir(COLOURS_DIR)
                for s in schemes:
                    sch = get_colourscheme(s.replace(".json", ""))
                    make_templates(cfg, sch)
            case "dump_mustache_data":
                sch = get_colourscheme(cfg["colourscheme"])
                data = merge_data(cfg, sch)
                print(json.dumps(data, indent=4))
            case _:
                help()
