#!/usr/bin/env python

from time import sleep
from math import floor
import subprocess
import argparse
from sys import argv
from os import path, makedirs
from threading import Thread

def update_timer(i):
    mins = floor(i / 60)
    secs = i - (mins * 60)
    mins = str(mins)
    secs = str(secs)
    if len(mins) == 1:
        mins = f"0{mins}"
    if len(secs) == 1:
        secs = f"0{secs}"
    subprocess.run(
        f"eww update mins='{mins}'; eww update secs='{secs}'",
        shell=True
    )


def recorder(audio, display, fmt, directory, select):
    if directory == "":
        directory = subprocess.run(
            "yzconf get recording_dir",
            shell=True,
            text=True,
            capture_output=True
        ).stdout.strip()
    if path.exists(directory) == False:
        makedirs(directory)
    date = subprocess.run(
        "date +%Y%m%d_%H:%M:%S",
        shell=True,
        capture_output=True,
        text=True
    ).stdout.strip()
    output = f"{directory}/recording-{date}.{fmt}"
    cmd = '''
    eww update mins='00' 
    eww update secs='00'
    eww update recording=true
    wf-recorder'''
    if audio == "true":
        cmd += " -a"
    if select == "true":
        r = subprocess.run(
            "slurp",
            capture_output=True,
            shell=True,
            text=True
        )
        geometry = r.stdout.strip()
        #print(geometry)
        if "selection cancelled" in geometry or geometry == "":
            exit(1)
        cmd += f" -g \"{geometry}\""
    elif display != "":
        cmd += f" -o {display}"
    cmd += f" -f {output}"
    print(cmd)
    p = subprocess.Popen(
        cmd,
        shell=True
    )
    i = 1
    while p.poll() is None:
        sleep(1)
        Thread(target=update_timer, args=(i,)).start()
        i += 1

    subprocess.run(
        f"eww update recording=false; notify-send 'Recording saved' '{output}'",
        shell=True
    )

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("-a", "--audio", default="false")
    parser.add_argument("-d", "--directory", default="")
    parser.add_argument("-f", "--format", default="mp4")
    parser.add_argument("-o", "--display", default="")
    parser.add_argument("-s", "--select", default="false")
    args = parser.parse_args(argv[1:])
    recorder(
        audio=args.audio,
        directory=args.directory,
        fmt=args.format,
        select=args.select,
        display=args.display
    )