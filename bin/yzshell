#!/usr/bin/env bash

BAR_LOG_FILE="/tmp/waybar.log"
EWW_LOG_FILE="/tmp/eww.log"
OSD_LOG_FILE="/tmp/swayosd.log"

function kill_yzshell() {
    killall waybar
    killall swayosd-server
    [ "$1" != "--no-wallpaper" ] && killall swaybg
    killall eww
}

function ensure_hyprland_plugins() {
    if ! hyprpm list | grep -q hyprbars; then
        echo ">> Installing Hyprland plugins..."
        terminal="$(yzconf get terminal)"
        (
            sleep 6
            exec $terminal -e yzshell-install-hyprland-plugins
        ) &
        disown
    fi
}

function launch_waybar() {
    exec waybar >$BAR_LOG_FILE 2>&1 &
    disown
    echo ">> Bar logs: ${BAR_LOG_FILE}"
}

function launch_widgets() {
    exec yzwidgets init >$EWW_LOG_FILE 2>&1 &
    disown
    echo ">> Widget logs: ${EWW_LOG_FILE}"
}

function launch_osd() {
    exec swayosd-server >$OSD_LOG_FILE 2>&1 &
    disown
    echo ">> OSD logs: ${OSD_LOG_FILE}"
}

function launch_wallpaper() {
    exec yzwallpaper >/dev/null 2>&1 &
    disown
}

function launch_yzshell() {
    [ "$1" != "--no-wallpaper" ] && launch_wallpaper
    launch_waybar
    launch_widgets
    launch_osd
    hyprctl reload &
    makoctl reload &
    ensure_hyprland_plugins
}

function get_logs() {
    case "$1" in
        "bar") tail -f $BAR_LOG_FILE ;;
        "widgets") tail -f $EWW_LOG_FILE ;;
        "osd") tail -f $OSD_LOG_FILE ;;
        *)
            echo "Error: invalid argument to 'yzshell logs': ${1}"
            exit 1
            ;;
    esac
}

function toggle_dnd() {
    if makoctl mode | grep -q do-not-disturb; then
        makoctl mode -r do-not-disturb
        notify-send "Notifications" "Do-not-disturb disabled"
    else
        makoctl mode -a do-not-disturb
    fi
    eww poll dnd_icon
}

function toggle_idle() {
    a="Idle inhibitor"
    b="enabled"
    if pgrep --quiet hypridle; then
        killall hypridle
    else
        exec hypridle &
        disown
        b="disabled"
    fi
    eww poll idle_icon
    echo "${a} ${b}"
    notify-send "${a}" "${b^}"
}

function yzshell_cmd() {
    case "$1" in
        "toggle_dnd") toggle_dnd ;;
        "toggle_idle_inhib") toggle_idle ;;
        *)
            echo "Error: invalid argument to yzshell cmd: '${1}'"
            exit 1
            ;;
    esac
}

function help() {
    echo "Usage: yzshell [OPTION] ...
    Options:
        logs <COMPONENT>: view logs for yzshell component
            Components:
                bar
                widgets
                osd
        cmd <COMMAND>: IPC commands
            Commands:
                toggle_dnd: toggle do-not-disturb
                toggle_idle_inhib: toggle idle inhibitor
        launch [COMPONENT] (default): launch shell
            Components:
                bar
                widgets
                osd
                wallpaper
        kill [COMPONENT]: kill shell
            Components:
                bar
                widgets
                osd
                wallpaper
        reload [COMPONENT] [FLAGS]: reload shell
            Components:
                bar
                widgets
                osd
                wallpaper
            Flags:
                --no-wallpaper: don't reload wallpaper
    "
}

function main() {
    case "$1" in
        "kill")
            case "${2}" in
                "bar") killall waybar ;;
                "osd") killall swayosd-server ;;
                "widgets") killall eww ;;
                "wallpaper") killall swaybg ;;
                *) kill_yzshell ;;
            esac
            ;;
        "reload")
            case "${2}" in
                "bar")
                    killall waybar
                    launch_waybar
                    ;;
                "osd")
                    killall swayosd-server
                    launch_osd
                    ;;
                "widgets")
                    killall eww
                    launch_widgets
                    ;;
                "wallpaper")
                    killall swaybg
                    launch_wallpaper
                    ;;
                *)
                    nw="--no-wallpaper"
                    arg=""
                    if [ "${2}" == "${nw}" ] || [ "${3}" == "${nw}" ]; then
                        arg="${nw}"
                    fi
                    kill_yzshell "${arg}"
                    launch_yzshell "${arg}"
                    ;;
            esac
            ;;
        "logs") get_logs "$2" ;;
        "cmd") yzshell_cmd "$2" ;;
        "bar" | "osd" | "widgets" | "wallpaper" | "launch")
            arg2=""
            if [ "${1}" == "launch" ]; then
                arg2="${2}"
            else
                arg2="${1}"
            fi
            case "${arg2}" in
                "bar") launch_waybar ;;
                "widgets") launch_widgets ;;
                "osd") launch_osd ;;
                "wallpaper") launch_walpaper ;;
                *) launch_yzshell ;;
            esac
            ;;
        *) help ;;
    esac
}

main "$@"
