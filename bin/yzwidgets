#!/usr/bin/env python

import json
import subprocess
from os import environ, path
from sys import argv, exit
from sys import path as sys_path

sys_path.append(environ["YZSHELL_PYTHON_LIB_DIR"])
from configutils import get_config


def init_widgets(config):
    wallpaper_path = path.join(config["wallpaper_dir"], config["wallpaper_image"])
    subprocess.run(
        f"""
        rm {environ["YZSHELL_WALLPAPER_LOCKFILE"]}
        eww daemon
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "apps.py")} &
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "schemes.py")} &
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "wallpapers.py")} &
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "schemes_background.py")} &
        bash {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "dnd_icon.sh")}
        bash {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "idle_icon.sh")}
        bash {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "get_os_version.sh")}
        eww poll weather_data
        eww update username="$(whoami)"
        eww update hostname="$(cat /etc/hostname)"
        eww update profile_image='{config["profile_image"]}'
        eww update recording_output='{config["recording_dir"]}'
        eww update current_scheme='{config["colourscheme"]}'
        eww update current_wallpaper='{wallpaper_path}'
        eww update wallpaper_mode='{config["wallpaper_mode"]}'
        eww update wallpaper_dir='{config["wallpaper_dir"]}'
        """,
        shell=True,
    )


def get_screen():
    return subprocess.run(
        "hyprctl monitors -j | jq '.[] | .id'",
        shell=True,
        text=True,
        capture_output=True,
    ).stdout.strip()


def open_control_center(screen, config):
    subprocess.run(
        f"""
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "apps.py")} &
        bash {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "dnd_icon.sh")} &
        bash {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "idle_icon.sh")} &
        eww update control_center_visible=true
        eww open closer --no-daemonize --screen {screen}
        eww open control_center --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"control_center\")'
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def close_control_center():
    subprocess.run(
        """
        eww close control_center
        eww update control_center_visible=false
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def open_workspaces(screen, args):
    subprocess.run(
        f"""
        eww update workspaces_visible=true
        eww open closer --no-daemonize --screen {screen}
        eww open workspaces --no-daemonize \\
            --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"workspaces\")'
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def close_workspaces():
    subprocess.run(
        """
        eww close workspaces
        eww update workspaces_visible=false
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def open_settings(screen, config):
    wallpaper_path = path.join(config["wallpaper_dir"], config["wallpaper_image"])
    subprocess.run(
        f"""
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "wallpapers.py")} &
        python {path.join(environ["YZSHELL_EWW_SCRIPT_DIR"], "schemes_background.py")} &
        eww open closer --no-daemonize --screen {screen}
        eww open settings --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"settings\")'
        eww update current_wallpaper='{wallpaper_path}'
        eww update wallpaper_mode='{config["wallpaper_mode"]}'
        eww update current_scheme='{config["colourscheme"]}'
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def close_settings():
    subprocess.run(
        """
        eww close settings
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def open_screenshot(screen, config):
    subprocess.run(
        f"""
        eww update screenshot_output="{config["screenshot_dir"]}/$(date +%d-%m-%Y_%H:%M:%S)_screenshot.png"
        eww open closer --no-daemonize --screen {screen}
        eww open screenshot --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"screenshot\")'
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )
    screenshot_set_output()


def close_screenshot():
    subprocess.run(
        """
        eww close screenshot
        eww poll screenshot_output
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def open_power(screen):
    subprocess.run(
        f"""
        eww open closer --no-daemonize --screen {screen}
        eww open power --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"power\")'
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def close_power():
    subprocess.run(
        """
        eww close power
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def open_calendar(screen):
    subprocess.run(
        f"""
        eww open closer --no-daemonize --screen {screen}
        eww open calendar --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"calendar\")'
        eww update calendar_visible=true
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def close_calendar():
    subprocess.run(
        """
        eww close calendar
        eww update calendar_visible=false
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def close_all_widgets():
    subprocess.run(
        """
        eww close-all
        hyprctl dispatch 'hl.dsp.submap(\"reset\")'
        eww update control_center_visible=false
        eww update calendar_visible=false
        eww update settings_visible=false
        eww update screenshot_visible=false
        eww update workspaces_visible=false
        eww poll search_results
        eww poll screenshot_output
        """,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )


def is_open(window):
    r = subprocess.run(
        f"eww active-windows | grep {window}", shell=True, capture_output=True
    ).returncode
    if r == 0:
        return True
    else:
        return False


def help(exitcode=0):
    print("""Usage: yzwidgets <OPTION> ...
    Options:
        init: start daemon and initialise widgets
        open <WIDGET>: opens widget 
        close <all|WIDGET>: closes widget
        toggle <WIDGET>: toggles widget
        state <WIDGET>: get open/close state of widget
    Widgets:
        control_center
        settings
        power
        calendar
        screenshot
        workspaces [FLAGS]
            Flags:
                -a | --anchor <ANCHOR>: anchor of widget (i.e. 'left bottom')
                -o | --orientation <h|v|horizontal|vertical>
    """)
    exit(exitcode)


if __name__ == "__main__":
    argc = len(argv)
    if argc > 1:
        match argv[1]:
            case "init":
                config = get_config()
                init_widgets(config)
            case "open":
                screen = get_screen()
                if argc > 2:
                    match argv[2]:
                        case "screenshot":
                            config = get_config()
                            open_screenshot(screen, config)
                        case "control_center":
                            config = get_config()
                            open_control_center(screen, config)
                        case "settings":
                            config = get_config()
                            open_settings(screen, config)
                        case "power":
                            open_power(screen)
                        case "calendar":
                            open_calendar(screen)
                        case "workspaces":
                            screen = get_screen()
                            open_workspaces(screen, argv[3:])
            case "close":
                if argc > 2:
                    match argv[2]:
                        case "screenshot":
                            close_screenshot()
                        case "control_center":
                            close_control_center()
                        case "settings":
                            close_settings()
                        case "power":
                            close_power()
                        case "calendar":
                            close_calendar()
                        case "workspaces":
                            close_calendar()
                        case "all":
                            close_all_widgets()
            case "toggle":
                if argc > 2:
                    match argv[2]:
                        case "screenshot":
                            if is_open("screenshot") == True:
                                close_screenshot()
                            else:
                                config = get_config()
                                screen = get_screen()
                                open_screenshot(screen, config)
                        case "control_center":
                            if is_open("control_center") == True:
                                close_control_center()
                            else:
                                config = get_config()
                                screen = get_screen()
                                open_control_center(screen, config)
                        case "settings":
                            if is_open("settings") == True:
                                close_settings()
                            else:
                                config = get_config()
                                screen = get_screen()
                                open_settings(screen, config)
                        case "power":
                            if is_open("settings") == True:
                                close_power()
                            else:
                                screen = get_screen()
                                open_power(screen)
                        case "calendar":
                            if is_open("calendar") == True:
                                close_calendar()
                            else:
                                screen = get_screen()
                                open_calendar(screen)
                        case "workspaces":
                            if is_open("workspaces") == True:
                                close_workspaces()
                            else:
                                screen = get_screen()
                                open_workspaces(screen, argv[3:])
            case "state":
                if argc > 1:
                    if is_open(argv[2]):
                        print("open")
                    else:
                        print("closed")
            case _:
                help()
