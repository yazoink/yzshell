#!/usr/bin/env python

import json
import subprocess
from os import environ, listdir, makedirs, path
from shutil import rmtree
from sys import argv, exit, stderr


def control_center_search_selected(direction="next"):
    r = subprocess.run(
        "eww get search_selected",
        shell=True,
        text=True,
        capture_output=True
    ).stdout.strip()
    selected = int(r)
    if direction == "next":
        r = subprocess.run(
            "eww get search_results",
            shell=True,
            text=True,
            capture_output=True
        ).stdout.strip()
        results = json.loads(r)
        l = len(results)
        if selected < l:
            selected += 1
    elif direction == "prev":
        if selected > -1:
            selected -= 1
    subprocess.run(
        f"eww update search_selected={selected}",
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT
    )


def get_conf_opt(opt):
    return subprocess.run(
        f"yzconf get {opt}",
        shell=True,
        text=True,
        capture_output=True
    ).stdout.strip()


def init_widgets():
    subprocess.run(
        '''
        eww daemon
        eww poll dnd_icon
        eww poll username
        eww poll hostname
        eww poll os_version
        eww poll profile_image_path
        eww poll recording_output
        eww poll search_results
        eww poll current_scheme
        eww poll wallpaper_dir
        eww poll wallpaper_mode
        eww poll current_wallpaper
        eww poll wallpaper_mode
        eww poll wallpapers_setter
        eww poll schemes_setter
        ''',
        shell=True,
    )


def get_screen():
    return subprocess.run(
        "hyprctl monitors -j | jq '.[] | .id'",
        shell=True,
        text=True,
        capture_output=True
    ).stdout.strip()


def open_control_center(screen):
    subprocess.run(
        f'''
        eww update control_center_visible=true
        eww open closer --no-daemonize --screen {screen}
        eww open control_center --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"control_center\")'
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )


def close_control_center():
    subprocess.run(
        '''
        eww close control_center
        eww update control_center_visible=false
        eww poll search_results
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )


def open_workspaces(screen, args):
    subprocess.run(
        f'''
        eww update workspaces_visible=true
        eww open closer --no-daemonize --screen {screen}
        eww open workspaces --no-daemonize \\
            --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"workspaces\")'
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )


def close_workspaces():
    subprocess.run(
        '''
        eww close workspaces
        eww update workspaces_visible=false
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )


