def open_calendar(screen):
    subprocess.run(
        f'''
        eww open closer --no-daemonize --screen {screen}
        eww open calendar --no-daemonize --screen {screen} \\
            && hyprctl dispatch 'hl.dsp.submap(\"calendar\")'
        eww update calendar_visible=true
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )


def close_calendar():
    subprocess.run(
        '''
        eww close calendar
        eww update calendar_visible=false
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )

def close_all_widgets():
    # if is_open("control_center"):
    #     subprocess.run(
    #         "eww poll search_results",
    #         shell=True,
    #         stdout=subprocess.DEVNULL, 
    #         stderr=subprocess.STDOUT
    #     )
    subprocess.run(
        '''
        eww close-all
        hyprctl dispatch 'hl.dsp.submap(\"reset\")'
        eww update control_center_visible=false
        eww update calendar_visible=false
        eww update settings_visible=false
        eww update screenshot_visible=false
        eww update workspaces_visible=false
        eww poll search_results
        ''',
        shell=True,
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.STDOUT
    )


def is_open(window):
    r = subprocess.run(
        f"eww active-windows | grep {window}",
        shell=True,
        capture_output=True
    ).returncode
    if r == 0:
        return True
    else:
        return False


def help(exitcode=0):
    print('''Usage: yzwidgets <OPTION> ...
    Options:
        init: start daemon and initialise widgets
        ctl <COMMAND>: IPC commands
            Commands:
                control_center_update_weather: 
                    update the weather information displayed by the 
                    control_center widget
                control_center_search_selected [DIRECTION]:
                    cycle app selecion in control_center launcher (will select 
                    next by default)
                    Directions:
                        next
                        prev
        open <WIDGET>: opens widget 
        close <all|WIDGET>: closes widget
        toggle <WIDGET>: toggles widget
        state <WIDGET>: get open/close state of widget
    Widgets:
        control_center
        settings
        power
        calendar
        screenshot
        workspaces [FLAGS]
            Flags:
                -a | --anchor <ANCHOR>: anchor of widget (i.e. 'left bottom')
                -o | --orientation <h|v|horizontal|vertical>
    ''')
    exit(exitcode)


if __name__ == "__main__":
    argc = len(argv)
    if argc > 1:
        match argv[1]:
            case "init":
                init_widgets()
            case "ctl":
                if argc > 2:
                    match argv[2]:
                        case "control_center_update_weather":
                            control_center_update_weather()
                        case "control_center_search_selected":
                            direction = "next"
                            if argc > 3:
                                if argv[3] == "prev":
                                    direction = "prev"
                            control_center_search_selected(direction)

            case "open":
                screen = get_screen()
                if argc > 2:
                    match argv[2]:
                        case "screenshot":
                            open_screenshot(screen)
                        case "control_center":
                            open_control_center(screen)
                        case "settings":
                            open_settings(screen)
                        case "power":
                            open_power(screen)
                        case "calendar":
                            open_calendar(screen)
                        case "workspaces":
                            screen = get_screen()
                            open_workspaces(
                                screen, 
                                argv[3:]
                            )
            case "close":
                if argc > 2:
                    match argv[2]:
                        case "screenshot":
                            close_screenshot()
                        case "control_center":
                            close_control_center()
                        case "settings":
                            close_settings()
                        case "power":
                            close_power()
                        case "calendar":
                            close_calendar()
                        case "workspaces":
                            close_calendar()
                        case "all":
                            close_all_widgets()
            case "toggle":
                if argc > 2:
                    match argv[2]:
                        case "screenshot":
                            if is_open("screenshot") == True:
                                close_screenshot()
                            else:
                                screen = get_screen()
                                open_screenshot(screen)
                        case "control_center":
                            if is_open("control_center") == True:
                                close_control_center()
                            else:
                                screen = get_screen()
                                open_control_center(screen)
                        case "settings":
                            if is_open("settings") == True:
                                close_settings()
                            else:
                                screen = get_screen()
                                open_settings(screen)
                        case "power":
                            if is_open("settings") == True:
                                close_power()
                            else:
                                screen = get_screen()
                                open_power(screen)
                        case "calendar":
                            if is_open("calendar") == True:
                                close_calendar()
                            else:
                                screen = get_screen()
                                open_calendar(screen)
                        case "workspaces":
                            if is_open("workspaces") == True:
                                close_workspaces()
                            else:
                                screen = get_screen()
                                open_workspaces(
                                    screen, 
                                    argv[3:]
                                )
            case "state":
                if argc > 1:
                    if is_open(argv[2]):
                        print("open")
                    else:
                        print("closed")
            case _:
                help()
