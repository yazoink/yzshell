(include "./calendar/widgets/clock.yuck")
(include "./calendar/widgets/reminders.yuck")

(defwindow calendar
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom right"
  )
  :stacking "fg"
  :exclusive false
  :focusable "ondemand"
  (box
    :orientation "h"
    :space-evenly false
    :class "calendar-container"
    :spacing 4
    (calendar_reminders)
    (box
      :orientation "vertical"
      :space-evenly false
      :class "calendar-box"
      :spacing 8
      :halign "fill"
      :valign "end"
      :vexpand true
      (calendar_clock)
      (box :class "calendar" :orientation "v" :valign "end" :vexpand true
        (calendar 
          :class "cal" 
          :halign "center"
          :onclick "$YZSHELL_EWW_SCRIPT_DIR/reminders.py dateclicked {0} {1} {2}"
        )
      )
    )
  )
)
