(defwidget calendar_clock []
  (box
    :orientation "vertical"
    :space-evenly false
    :spacing 0
    :class "pretty-time"
    (box
      :orientation "horizontal"
      :space-evenly false
      :spacing 4
      :halign "center"
      :class "clock"
      (label :text "${hour}")
      (box
        :orientation "vertical"
        :space-evenly "true"
        :valign "center"
        :spacing 4
        :class "separator"
        (label :text "" :class "red")
        (label :text "" :class "green")
        (label :text "" :class "blue")
      )
      (label :text "${minute}")
    )
    (label :text "${date}" :class "date")
  )
)
