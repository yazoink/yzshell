(defwidget calendar_clock []
  (box
    :orientation "vertical"
    :space-evenly false
    :spacing 0
    :class "pretty-time"
    (box
      :orientation "horizontal"
      :space-evenly false
      :spacing 4
      :halign "center"
      :class "clock"
      (label :text "${hour}")
      (vertical_separator)
      (label :text "${minute}")
    )
    (label :text "${date}" :class "date")
  )
)
