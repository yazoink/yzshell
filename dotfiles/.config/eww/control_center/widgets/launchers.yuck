(defwidget launchers []
  (box
    :orientation "v"
    :class "launchers-box"
    :space-evenly false
    (box
      :orientation "v"
      :valign "start"
      :spacing 8
      :space-evenly false
      :vexpand true
      (icon_button
        :icon ""
        :tooltip "Change appearance"
        :size "medium"
        :colour "cyan"
        :command "yzwidgets close control_center & yzwidgets open settings &"
      )
      (icon_button
        :icon idle_icon
        :tooltip "Toggle idle inhibitor"
        :size "medium"
        :colour "green"
        :command "yzshell cmd toggle_idle_inhib &"
      )
      (icon_button
        :icon ""
        :tooltip "Take a screenshot"
        :size "medium"
        :colour "yellow"
        :command "yzwidgets close control_center & yzwidgets open screenshot &"
      )
      (icon_button
        :icon dnd_icon
        :tooltip "Toggle do-not-disturb"
        :size "medium"
        :colour "orange"
        :command "yzshell cmd toggle_dnd &"
      )
    )
    (box
      :orientation "v"
      :valign "end"
      :spacing 8
      :space-evenly true
      :vexpand true
      (icon_button
        :icon ""
        :tooltip "Open power menu"
        :size "medium"
        :colour "red"
        :command "yzwidgets close control_center & yzwidgets open power &"
      )
    )
  )
)


