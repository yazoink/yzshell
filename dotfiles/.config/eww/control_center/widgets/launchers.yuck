(defwidget launcher_button [name command tooltip icon]
  (button
    :class "launcher-button ${name}"
    :tooltip tooltip
    :onclick command
    (label :text icon :class "icon")
  )
)

(defwidget launchers []
  (box
    :orientation "v"
    :class "launchers-box"
    :space-evenly false
    (box
      :orientation "v"
      :valign "start"
      :spacing 8
      :space-evenly false
      :vexpand true
      (launcher_button
        :name "settings"
        :tooltip "Change appearance"
        :command "yzwidgets close control_center & yzwidgets open settings &"
        :icon ""
      )
      (launcher_button
        :name "idle"
        :tooltip "Toggle idle inhibitor"
        :command "yzshell cmd toggle_idle_inhib &"
        :icon idle_icon
      )
      (launcher_button
        :name "shot"
        :tooltip "Take screenshot"
        :command "yzwidgets close control_center & yzwidgets open screenshot &"
        :icon ""
      )
      (launcher_button
        :name "dnd"
        :tooltip "Toggle do-not-disturb"
        :command "yzshell cmd toggle_dnd &"
        :icon dnd_icon
      )
    )
    (box
      :orientation "v"
      :valign "end"
      :spacing 8
      :space-evenly true
      :vexpand true
      (launcher_button
        :name "shutdown"
        :tooltip "Open power menu"
        :command "yzwidgets close control_center & yzwidgets open power &"
        :icon ""
      )
    )
  )
)


