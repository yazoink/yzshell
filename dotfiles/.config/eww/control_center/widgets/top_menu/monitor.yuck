(defpoll cpu 
  :run-while {menu_item == 1 && control_center_visible} 
  :interval "3s" 
  "$YZSHELL_EWW_SCRIPT_DIR/cpu_perc.sh"
)

(defpoll temp 
  :run-while {menu_item == 1 && control_center_visible}
  :interval "3s" 
  "$YZSHELL_EWW_SCRIPT_DIR/cpu_temp.sh"
)

(defwidget monitor []
  (box
    :class "monitor-box"
    :orientation "v"
    :spacing 8
    :halign "fill"
    :hexpand true
    (box
      :orientation "h"
      :spacing 8
      :halign "center"
      (box
        :class "monitor-item cpu red"
        (label :text "" :class "icon")
        (label :text "${cpu}%" :class "usage")
      )
      (box
        :class "monitor-item ram yellow"
        (label :text "" :class "icon")
        (label :text "${round(EWW_RAM.used_mem_perc, 0)}%" :class "usage")
      )
    )
    (box
      :orientation "h"
      :spacing 8
      :halign "center"
      (box
        :class "monitor-item disk green"
        (label :text "" :class "icon")
        (label :text "${round(EWW_DISK["/"].used_perc, 0)}%" :class "usage")
      )
      (box
        :class "monitor-item temp blue"
        (label :text "" :class "icon")
        (label :text "${temp}°C" :class "usage")
      )
    )
  )
)
