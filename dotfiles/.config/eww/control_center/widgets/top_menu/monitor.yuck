(defwidget monitor_usage [name colour icon tooltip value]
  (box
    :class "monitor-item ${name}"
    :tooltip tooltip
    (label :text icon :class "monitor-icon ${colour}")
    (label :text value :class "usage")
  )
)

(defwidget monitor []
  (box
    :class "monitor-box"
    :orientation "v"
    :spacing 8
    :halign "fill"
    :hexpand true
    (box
      :orientation "h"
      :spacing 8
      :halign "center"
      (monitor_usage
        :name "cpu"
        :tooltip "CPU usage"
        :icon ""
        :colour "red"
        :value "${cpu}%"
      )
      (monitor_usage
        :name "ram"
        :tooltip "Memory usage"
        :icon ""
        :colour "yellow"
        :value "${round(EWW_RAM.used_mem_perc, 0)}%"
      )
    )
    (box
      :orientation "h"
      :spacing 8
      :halign "center"
      (monitor_usage
        :name "disk"
        :tooltip "Disk usage"
        :icon ""
        :colour "green"
        :value "${round(EWW_DISK["/"].used_perc, 0)}%"
      )
      (monitor_usage
        :name "temp"
        :tooltip "CPU temperature"
        :icon ""
        :colour "blue"
        :value "${temp}°C"
      )
    )
  )
)
