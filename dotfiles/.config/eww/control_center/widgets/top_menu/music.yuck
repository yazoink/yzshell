;(defpoll song :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "playerctl metadata title || echo 'Nothing playing...'")
;(defpoll song_artist :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "playerctl metadata artist || echo 'Click to open player'")
;(defpoll song_status :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "control_center/scripts/get_player_status.sh")
;(defpoll cover_art :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "control_center/scripts/get_album_cover.sh")

(defpoll song 
  :run-while {menu_item == 0 && control_center_visible} 
  :interval "3s"  
  "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --song"
)

(defpoll song_artist 
  :run-while {menu_item == 0 && control_center_visible} 
  :interval "3s"  
  "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --artist"
)

(defpoll song_status 
  :run-while {menu_item == 0 && control_center_visible} 
  :interval "3s"  
  "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --status"
)

(defpoll cover_art 
  :run-while {menu_item == 0 && control_center_visible} 
  :interval "3s"  
  "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --cover"
)

(defwidget music []
  (box
    :class "music-box"
    :orientation "h"
    :space-evenly false
    :spacing 8
    (box
      :class "album-cover"
      :vexpand "false" 
      :hexpand "false" 
      :style {cover_art == "" 
          ? "" 
          : "background-image: url('${cover_art}');"
        }
      (label 
        :text "" 
        :visible {cover_art == "" ? true : false} 
        :class "music-placeholder"
      )
    )
    (box
      :orientation "v"
      :class "music-info-controls"
      :halign "center"
      :valign "center"
      :hexpand true
      :space-evenly false
      :tooltip "Open music player"
      (button
        :onclick "yzwidgets close all & $(yzconf get terminal) -e ncmpcpp & disown"
        (box
          :class "music-info"
          :orientation "v"
          :halign "center"
          :valign "center"
          :hexpand true
          :space-evenly false
          (label 
            :class "song"
            :text "${song}" 
            :wrap true 
            :wrap-mode "word"
            :limit-width 25
            :lines 3 
            :justify "center"
          )
          (label 
            :class "artist"
            :text "${song_artist}" 
            :wrap false 
            :justify "center"
          )
        )
      )
      (box
        :class "controls"
        :orientation "h"
        :spacing 4
        :halign "center"
        :hexpand true
        (button 
          :class "prev" 
          :onclick "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --prev" 
          ""
        )
        (button 
          :class "toggle" 
          :onclick "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --toggle" 
          song_status
        )
        (button 
          :class "next" 
          :onclick "$YZSHELL_EWW_SCRIPT_DIR/music_info.sh --prev" 
          ""
        )
      )
    )
  )
)
