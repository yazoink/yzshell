(defwidget notes []
    (box
        :class "notes-box"
        :halign "fill"
        (overlay
            (scroll
                :height 140
                :hscroll false
                :vscroll true
                (box
                    (label
                        :class "notes-body"
                        :valign "start"
                        :halign "start"
                        :xalign 0
                        :wrap true
                        :markup notes
                    )
                )
            )
            (box
                :valign "end"
                :vexpand true
                :halign "end"
                :hexpand true
                (icon_button
                    :icon ""
                    :tooltip "Make some notes"
                    :size "small"
                    :colour "accent"
                    :command "yzwidgets close all & ${editor_cmd} ~/.notes.md & disown"
                )
            )
        )
    )
)

