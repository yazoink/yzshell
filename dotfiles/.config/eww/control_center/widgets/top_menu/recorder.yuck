(defpoll recording_output 
  :interval "10s"
  :run-while false
  "yzconf get recording_dir"
)
(defvar recording_format "mp4")
(defvar record_audio false)
(defpoll recorder_updater
  :run-while {menu_item == 3 && control_center_visible} 
  :interval "3s" 
  :initial ""
  "control_center/scripts/is_recording.sh"
)
(defvar recorder_selected 0)
(defvar mins "00")
(defvar secs "00")

(defwidget recorder_recording []
  (box
    :orientation "v"
    :space-evenly false
    :class "recording"
    :halign "center"
    :hexpand true
    (label 
      :halign "center" 
      :hexpand true 
      :text "Recording..." 
      :class "recording-label"
    )
    (box
      :orientation "h"
      :space-evenly false
      :spacing 4
      :halign "center"
      :hexpand "true"
      (label :class "timer" :text mins)
      (box
        :orientation "vertical"
        :space-evenly "true"
        :valign "center"
        :spacing 4
        :class "separator"
        (label :text "" :class "red")
        (label :text "" :class "green")
        (label :text "" :class "blue")
      )
      (label :class "timer" :text secs)
    )
    (button
      :onclick "control_center/scripts/stop_recording.sh &"
      :halign "center"
      :hexpand "true"
      "Stop"
    )
  )
)

(defwidget recorder_not_recording []
  (box
    :orientation "v"
    :space-evenly false
    :halign "fill"
    :valign "center"
    :vexpand true
    :spacing 8
    (box
      :orientation "h"
      :space-evenly false
      :halign "center"
      :hexpand true
      :spacing 8
      (label :text "Save to:")
      (input :value recording_output)
      (label :text "Format:")
      (overlay
        (box
          :class "combo-box-format"
          (label :text "${recording_format}  ")
        )
        (combo-box-text
          :class "combo-box"
          :items "[mp4,mkv]"
          :onchange "${EWW_CMD} update recording_format='{}'"
        )
      )
    )
    (box
      :orientation "h"
      :space-evenly false
      :halign "center"
      :hexpand true
      :spacing 8
      (button 
        :class "recorder-button"
        :onclick `yzrecorder \
          --audio ${record_audio} \
          --directory ${recording_output} \
          --format ${recording_format} \
          --select true & disown`
        "Record region"
      )
      (button 
        :class "recorder-button"
        :onclick `yzrecorder \
          --audio ${record_audio} \
          --directory ${recording_output} \
          --format ${recording_format} & disown`
        "Record screen"
      )
      (checkbox 
        :checked record_audio
        :onchecked "${EWW_CMD} update record_audio=true"
        :onunchecked "${EWW_CMD} update record_audio=false"
      )
      (label :text "Audio")
    )
  )
)

(defwidget recorder []
  (box
    :class "recorder-box"
    :orientation "v"
    :space-evenly false
    :halign "fill"
    (stack
      :same-size "false"
      :transition "slideleft"
      :selected recorder_selected
      (recorder_recording)
      (recorder_not_recording)
    )
  )
)
