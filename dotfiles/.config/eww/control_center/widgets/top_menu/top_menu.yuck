(include "control_center/widgets/top_menu/monitor.yuck")
(include "control_center/widgets/top_menu/weather.yuck")
(include "control_center/widgets/top_menu/music.yuck")
(include "control_center/widgets/top_menu/recorder.yuck")

(defwidget menu_button [name class tooltip icon index]
  (button
    :class "${class} ${control_center_menu_item == index ? "selected" : ""}"
    :onclick "$YZSHELL_EWW_SCRIPT_DIR/slide.py ${control_center_menu_item} ${index} control_center_menu_item"
    :tooltip tooltip
    (box
      :orientation "h"
      :space-evenly false
      (label :text icon :class "icon")
      (revealer
        :transition stack_transition
        :reveal {control_center_menu_item == index ? true : false}
        (label :text name)
      )
    )
  )
)

(defwidget control_center_menu []
  (box
    :orientation "v"
    :space-evenly false
    :class "menu-container"
    (stack
      :selected control_center_menu_item
      :class "menu-content"
      :same-size false
      :transition stack_transition
      :same-size false
      (music)
      (monitor)
      (weather)
      (recorder)
    )
    (box
      :class "menu-box"
      :halign "fill"
      :space-evenly true
      :hexpand true
      (box
        :orientation "h"
        :halign "center"
        :space-evenly false
        :spacing 8
        (menu_button
          :name "Music"
          :tooltip "Music controls"
          :class "music"
          :icon ""
          :index 0
        )
        (menu_button
          :name "Resources"
          :tooltip "Resource monitor"
          :class "monitor"
          :icon ""
          :index 1
        )
        (menu_button
          :name "Weather"
          :tooltip "Weather"
          :class "weather"
          :icon ""
          :index 2
        )
        (menu_button
          :name "Recorder"
          :tooltip "Screen recorder"
          :class "recorder"
          :icon ""
          :index 3
        )
      )
    )
  )
)
