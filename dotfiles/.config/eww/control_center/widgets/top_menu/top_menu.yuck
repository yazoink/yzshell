(include "control_center/widgets/top_menu/monitor.yuck")
(include "control_center/widgets/top_menu/weather.yuck")
(include "control_center/widgets/top_menu/music.yuck")
(include "control_center/widgets/top_menu/recorder.yuck")

(defwidget control_center_menu []
  (box
    :orientation "v"
    :space-evenly false
    :class "menu-container"
    (stack
      :selected control_center_menu_item
      :class "menu-content"
      :same-size false
      :transition stack_transition
      :same-size false
      (music)
      (monitor)
      (weather)
      (recorder)
    )
    (box
      :class "menu-box"
      :halign "fill"
      :space-evenly true
      :hexpand true
      (box
        :orientation "h"
        :halign "center"
        :space-evenly false
        :spacing 8
        (menu_button
          :name "Music"
          :tooltip "Music controls"
          :colour "red"
          :icon ""
          :index 0
          :curr_selected control_center_menu_item
          :menu_var "control_center_menu_item"
        )
        (menu_button
          :name "Resources"
          :tooltip "Resource monitor"
          :colour "orange"
          :icon ""
          :index 1
          :curr_selected control_center_menu_item
          :menu_var "control_center_menu_item"
        )
        (menu_button
          :name "Weather"
          :tooltip "Weather"
          :colour "yellow"
          :icon ""
          :index 2
          :curr_selected control_center_menu_item
          :menu_var "control_center_menu_item"
        )
        (menu_button
          :name "Recorder"
          :tooltip "Screen recorder"
          :colour "green"
          :icon ""
          :index 3
          :curr_selected control_center_menu_item
          :menu_var "control_center_menu_item"
        )
      )
    )
  )
)
