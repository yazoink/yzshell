(defpoll weather_data :interval "5m" "$YZSHELL_EWW_SCRIPT_DIR/weather.py &")

(defwidget weather []
  (box
    :class "weather-box"
    :orientation "v"
    :space-evenly false
    :halign "fill"
    (label :text {weather_data.location} :class "timezone")
    (box
      :orientation "h"
      :space-evenly false
      :halign "center"
      :valign "center"
      :hexpand true
      :spacing 8
      (label
        :class "icon ${weather_data.colour}"
        :text {weather_data.icon}
      )
      ;(image 
      ;  :image-width 50
      ;  :image-height 50
      ;  :path "control_center/images/weather/${weather_data.icon}.svg"
      ;)
      (box
        :class "temp-apparent-temp"
        :orientation "v"
        :valign "center"
        :space-evenly false
        :halign "start"
        :hexpand true
        :vexpand true
        (label :text {weather_data.temp} :class "temp" :halign "center")
        (label :text {weather_data.appar_temp} :class "apparent_temp" :halign "center")
      )
    )
  )
)
