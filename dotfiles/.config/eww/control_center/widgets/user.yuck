(defpoll username :interval "24h" `whoami`)
(defpoll hostname :interval "24h" `cat /etc/hostname`)
(defpoll os_version :interval "24h" "control_center/scripts/get_os_version.sh")
(defpoll profile_image_path :interval "24h" "yzconf get profile_image")

(defwidget user []
  (box
    :class "user-box"
    :orientation "horizontal"
    :valign "start"
    :spacing 8
    :space-evenly false
    :halign "fill"
    :hexpand true
    (box
      :class "profile-image"
      :vexpand false 
      :hexpand false 
      :style "background-image: url('${profile_image_path}');"
    )
    (box
      :class "username-hostname-os"
      :orientation "vertical"
      :space-evenly false
      :valign "center"
      (box
        :class "username-hostname"
        :halign "start"
        :hexpand true
        :space-evenly false
        :orientation "horizontal"
        (label :text "${username}" :class "username" :halign "start")
        (label :text "@" :class "at")
        (label :text "${hostname}" :class "hostname")
      )
      (label :text "${os_version}" :class "os-version" :halign "start")
    )
  )
)
