(defwidget user []
  (box
    :class "user-box"
    :orientation "horizontal"
    :valign "start"
    :spacing 8
    :space-evenly false
    :halign "fill"
    :hexpand true
    (button
      :tooltip "Change profile image"
      :onclick `(
        ${EWW_CMD} update settings_menu_item=4
        yzwidgets close control_center 
        yzwidgets open settings
      ) &`
      (box
        :class "profile-image"
        :vexpand false 
        :hexpand false 
        :style "background-image: url('${profile_image}');"
      )
    )
    (box
      :class "username-hostname-os"
      :orientation "vertical"
      :space-evenly false
      :valign "center"
      (box
        :class "username-hostname"
        :halign "start"
        :hexpand true
        :space-evenly false
        :orientation "horizontal"
        (label :text username :class "username" :halign "start")
        (label :text "@" :class "at")
        (label :text hostname :class "hostname")
      )
      (label :text os_version :class "os-version" :halign "start")
    )
  )
)
