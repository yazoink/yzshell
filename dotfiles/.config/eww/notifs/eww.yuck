(deflisten all_notifs "tail -F /tmp/notifs.json")
(deflisten expired_notifs "tail -F /tmp/expired_notifs.json")
;(deflisten notifs_service "notifs/scripts/read_notifs.sh")

(defwidget ntf [n expired]
  (button
    :onclick "notifs/scripts/read_notifs.sh delete ${n["id"]}${expired ? " --expired" : ""}"
    :class "notif"
    (box
      :orientation "h"
      :spacing 12
      :space-evenly false
      (image 
        :visible {"${n["icon"]}" == "None" ? false : true} 
        :path "${n["icon"]}" 
        :image-width 65 
        :preserve-aspect-ratio true
        :halign "start"
      )
      (box
        :orientation "v"
        :valign "center"
        :vexpand true
        :spacing 8
        :space-evenly false
        :halign "start"
        :hexpand true
        (label 
          :text "${n["summary"]}" 
          :class "summary" 
          :truncate true
          :halign "start" 
          :hexpand true
        )
        (label 
          :text "${n["body"]}" 
          :class "body" 
          :truncate true
          :halign "start" 
          :hexpand true
        )
      )
    )
  )
)

(defwindow notification_center
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom right"
  )
  :stacking "fg"
  :exclusive false
  :focusable false
  (box
    :class "notification-center"
    :orientation "v"
    :spacing 8
    :space-evenly false
    (label 
      :text "Notifications" 
      :class "notification-center-header"
      :halign "start"
    )
    (scroll
      :class "notifs-scroller"
      :hscroll false
      :vscroll true
      :valign "fill"
      :height 400
      (box
        :class "notifs-box"
        :orientation "v"
        :spacing 8
        :space-evenly false
        (for n in expired_notifs (ntf :n n :expired true))
      )
    )
  )
)

(defwindow notifs
:monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :width 300
    :anchor "bottom right"
  )
  :stacking "fg"
  :exclusive false
  :focusable false
  (box
    :orientation "v"
    :class "notifs"
    :spacing 4
    :space-evenly false
    (for n in all_notifs
      (ntf :n n :expired false)
    )
  )
)