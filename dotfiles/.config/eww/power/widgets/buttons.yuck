(defwidget yes_no [action cmd]
  (box
    :orientation "v"
    :spacing 8
    :space-evenly false
    :valign "center"
    :vexpand true
    :class "yes-no"
    (label :text action :class "action")
    (box
      :orientation "h"
      :spacing 8
      :space-evenly false
      :valign "center"
      :halign "center"
      (icon_button
        :icon ""
        :tooltip "${action}"
        :size "small"
        :colour "green"
        :command "${cmd}"
      )
      (icon_button
        :icon ""
        :tooltip "Cancel"
        :size "small"
        :colour "red"
        :command "yzwidgets close all &"
      )
    )
  )
)

(defwidget power_button [index class icon desc cmd]
  (box
    :orientation "h"
    :space-evenly false
    :class "power-button"
    :valign "fill"
    (button
      :class "${class} ${power_selected == index ? "selected" : ""}"
      :onclick "$YZSHELL_EWW_SCRIPT_DIR/slide.py ${power_selected} ${index} power_selected"
      :tooltip desc
      (label :text icon :class "icon power-button-icon")
    )
    (revealer
      :transition "slideright"
      :reveal {power_selected == index}
      (yes_no :action desc :cmd cmd)
    )
  )
)

(defwidget power_buttons []
  (box
    :orientation "h"
    :class "power-buttons-box"
    :space-evenly false
    :vexpand false
    :valign "end"
    :spacing 8
    ;:visible power_visible
    (for button in power_buttons_arr
      (power_button
        :index {button["index"]}
        :class {button["class"]}
        :icon {button["icon"]}
        :desc {button["desc"]}
        :cmd {button["cmd"]}
      )
    )
  )
)
