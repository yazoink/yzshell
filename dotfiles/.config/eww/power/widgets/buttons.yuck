(defwidget yes_no [action cmd]
  (box
    :orientation "v"
    :spacing 8
    :space-evenly false
    :valign "center"
    (label :text action :class "action")
    (box
      :orientation "h"
      :spacing 8
      :space-evenly false
      :valign "center"
      :halign "center"
      (button :onclick "${cmd}" :timeout "800ms" :class "yes green" "")
      (button :onclick "yzwidgets close all &" :class "no red" "")
    )
  )
)

(defwidget power_button [index class icon desc cmd]
  (box
    :orientation "h"
    :space-evenly false
    :class "power-button"
    (button
      :class "${class} ${power_selected == index ? "selected" : ""}"
      :onclick "$YZSHELL_EWW_SCRIPT_DIR/slide.py ${power_selected} ${index} power_selected"
      :tooltip desc
      (label :text icon :class "icon")
    )
    (revealer
      :transition "slideright"
      :reveal {power_selected == index}
      (yes_no :action desc :cmd cmd)
    )
  )
)

(defwidget power_buttons []
  (box
    :orientation "h"
    :class "power-buttons-box"
    :space-evenly false
    :vexpand false
    :valign "end"
    :spacing 8
    ;:visible power_visible
    (for button in power_buttons_arr
      (power_button
        :index {button["index"]}
        :class {button["class"]}
        :icon {button["icon"]}
        :desc {button["desc"]}
        :cmd {button["cmd"]}
      )
    )
  )
)
