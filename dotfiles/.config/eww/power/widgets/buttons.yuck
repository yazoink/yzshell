(defwidget yes_no [action cmd]
  (box
    :orientation "v"
    :spacing 8
    :space-evenly false
    :valign "center"
    (label :text action :class "action")
    (box
      :orientation "h"
      :spacing 8
      :space-evenly false
      :valign "center"
      :halign "center"
      (button :onclick "${cmd}" :timeout "800ms" :class "yes green" "")
      (button :onclick "yzwidgets close all &" :class "no red" "")
    )
  )
)

(defwidget power_button [class icon desc cmd]
  (box
    :orientation "h"
    :space-evenly false
    :class "power-button"
    (button
      :class "${class} ${power_selected == class ? "selected" : ""}"
      :onclick {
        power_selected == class 
        ? "${EWW_CMD} update power_selected=''" 
        : "${EWW_CMD} update power_selected='${class}'"
      }
      :tooltip desc
      (label :text icon :class "icon")
    )
    (revealer
      :transition "slideright"
      :reveal {power_selected == class}
      (yes_no :action desc :cmd cmd)
    )
  )
)

(defwidget power_buttons []
  (box
    :orientation "h"
    :class "power-buttons-box"
    :space-evenly false
    :vexpand false
    :valign "end"
    :spacing 8
    ;:visible power_visible
    (for button in power_buttons_arr
      (power_button
        :class {button["class"]}
        :icon {button["icon"]}
        :desc {button["desc"]}
        :cmd {button["cmd"]}
      )
    )
  )
)
