(include "settings/widgets/wallpaper.yuck")
(include "settings/widgets/colours.yuck")
(include "settings/widgets/bar.yuck")
(include "settings/widgets/fonts.yuck")
(include "settings/widgets/profile_image.yuck")
(include "settings/widgets/weather.yuck")

(defwidget settings_menu_button [index icon tooltip text class]
    (button
      :onclick "${EWW_CMD} update settings_menu_item=${index}"
      :tooltip tooltip
      :class "${class} ${settings_menu_item == index ? "selected" : ""}"
      (box
        :orientation "h"
        :space-evenly false
        (label :text icon :class "icon")
        (revealer
          :transition stack_transition
          :reveal {settings_menu_item == index ? true : false}
          (label :text text)
        )
      )
    )
)

(defwindow settings
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom left"
  )
  :stacking "fg"
  :exclusive false
  :focusable "ondemand"
  (box
    ;:visible settings_visible
    :orientation "h"
    :class "settings-box"
    :space-evenly false
    :vexpand false
    :spacing 8
    (box
      :class "settings-menu"
      :orientation "v"
      :halign "start"
      :valign "end"
      :vexpand true
      :space-evenly false
      :spacing 8
      (icon_button
        :icon ""
        :tooltip "Wallpaper settings"
        :size "medium"
        :colour "red"
        :command "${EWW_CMD} update settings_menu_item=0"
        :class {settings_menu_item == 0 ? "selected" : ""}
      )
      (icon_button
        :icon ""
        :tooltip "Colourscheme"
        :size "medium"
        :colour "yellow"
        :command "${EWW_CMD} update settings_menu_item=1"
        :class {settings_menu_item == 1 ? "selected" : ""}
      )
      (icon_button
        :icon ""
        :tooltip "Fonts"
        :size "medium"
        :colour "green"
        :command "${EWW_CMD} update settings_menu_item=2"
        :class {settings_menu_item == 2 ? "selected" : ""}
      )
      (icon_button
        :icon ""
        :tooltip "Misc."
        :size "medium"
        :colour "blue"
        :command "${EWW_CMD} update settings_menu_item=3"
        :class {settings_menu_item == 3 ? "selected" : ""}
      )
    )
    (stack
      :selected settings_menu_item
      :class "settings-content"
      :same-size false
      :transition "slidedown"
      (wallpaper)
      (colourschemes)
      (font_settings)
      (box
        :spacing 4
        :space-evenly false
        :orientation "v"
        (bar_settings)
        (weather_settings)
        (pfp_settings)
      )
    )
  )
)