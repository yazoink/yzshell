(include "settings/widgets/wallpaper.yuck")
(include "settings/widgets/colours.yuck")

(defwidget settings_menu_button [index icon tooltip text class]
    (button
      :onclick "${EWW_CMD} update settings_menu_item=${index}"
      :tooltip tooltip
      :class "${class} ${settings_menu_item == index ? "selected" : ""}"
      (box
        :orientation "h"
        :space-evenly false
        (label :text icon :class "icon")
        (revealer
          :transition stack_transition
          :reveal {settings_menu_item == index ? true : false}
          (label :text text)
        )
      )
    )
)

(defwindow settings
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom center"
  )
  :stacking "fg"
  :exclusive false
  :focusable "ondemand"
  (box
    ;:visible settings_visible
    :orientation "v"
    :class "settings-box"
    :space-evenly false
    :vexpand false
    :spacing 8
    (box
      :class "settings-menu"
      :orientation "h"
      :halign "fill"
      :space-evenly true
      :hexpand true
      (box
        :orientation "h"
        :halign "center"
        :space-evenly false
        :spacing 8
        (menu_button
          :name "Wallpaper"
          :tooltip "Wallpaper settings"
          :colour "red"
          :icon ""
          :index 0
          :curr_selected settings_menu_item
          :menu_var "settings_menu_item"
        )
        (menu_button
          :name "Colourscheme"
          :tooltip "Colourscheme settings"
          :colour "orange"
          :icon ""
          :index 1
          :curr_selected settings_menu_item
          :menu_var "settings_menu_item"
        )
      )
    )
    (stack
      :selected settings_menu_item
      :class "settings-content"
      :same-size true
      :transition {settings_menu_item == 0 ? "slideleft" : "slideright"}
      (wallpaper)
      (colourschemes)
    )
  )
)
