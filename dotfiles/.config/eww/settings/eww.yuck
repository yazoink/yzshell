(defvar settings_visible false)
(defvar settings_menu_item 0)

(include "settings/widgets/wallpaper.yuck")
(include "settings/widgets/colours.yuck")

(defwindow settings
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom center"
  )
  :stacking "fg"
  :exclusive false
  :focusable "ondemand"
  (box
    ;:visible settings_visible
    :orientation "v"
    :class "settings-box"
    :space-evenly false
    :vexpand false
    :spacing 8
    (box
      :class "settings-menu"
      :orientation "h"
      :halign "fill"
      :space-evenly true
      :hexpand true
      (box
        :orientation "h"
        :halign "center"
        :space-evenly false
        :spacing 8
        (button
          :onclick "${EWW_CMD} update settings_menu_item=0"
          :tooltip "Wallpaper settings"
          :class "wallpaper ${settings_menu_item == 0 ? "selected" : ""}"
          (box
            :orientation "h"
            :space-evenly false
            (label :text "" :class "icon")
            (revealer
              :transition "slideright"
              :reveal {settings_menu_item == 0 ? true : false}
              (label :text "Wallpaper")
            )
          )
        )
        (button
          :onclick "${EWW_CMD} update settings_menu_item=1"
          :tooltip "Colourscheme settings"
          :class "colours ${settings_menu_item == 1 ? "selected" : ""}"
          (box
            :orientation "h"
            :space-evenly false
            (label :text "" :class "icon")
            (revealer
              :transition "slideright"
              :reveal {settings_menu_item == 1 ? true : false}
              (label :text "Colourscheme")
            )
          )
        )
      )
    )
    (stack
      :selected settings_menu_item
      :class "settings-content"
      :same-size false
      :transition "slideleft"
      (wallpaper)
      (colourschemes)
    )
  )
)
