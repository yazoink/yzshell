(defvar light_colourschemes `[]`)
(defvar dark_colourschemes `[]`)
(defvar schemes_selected 0)
(defvar current_scheme "")
(defvar scheme_query "")
(defvar colourschemes_bg_image "")
(defvar no_light_schemes_found false)
(defvar no_dark_schemes_found false)
(defvar scheme_cols `[
  "background",
  "foreground",
  "red",
  "orange",
  "yellow",
  "green",
  "cyan",
  "blue",
  "purple",
  "brown"
]`)

(defwidget colour [hex border]
  (button
    :onclick "wl-copy '${hex}'; notify-send '${hex}' 'Copied to clipboard.'"
    :class "colour"
    :style "background-color: ${hex}; border: 1px solid ${border};"
    :tooltip "${hex} (click to copy)"
    (box
      :width 35
      :height 35
    )
  )
)

(defwidget scheme_preview_heading [text text_col star_col]
  (box
    :orientation "h"
    :space-evenly false
    :spacing 8
    (label
      :class "title"
      :style "color: ${star_col}; font-family: 'Font Awesome 7 Free';"
      :valign "center"
      :halign "start"
      :text ""
    )
    (label 
      :class "title" 
      :style "color: ${text_col}; font-size: 17pt;" 
      :valign "start"
      :halign "start"
      :vexpand true
      :hexpand true
      :text text
    )
  )
)

(defwidget scheme_preview [scheme]
  (box
    :class "scheme-preview"
    :space-evenly false
    :orientation "v"
    :style "background-color: #${scheme["background"]}; border: 1px solid transparentize(#${scheme["foreground"]}, 0.9);"
    (overlay
      :class "header"
      :halign "fill"
      (box
        :class "window-buttons"
        :halign "start"
        :hexpand true
        :spacing 8
        (for b in {scheme.window_buttons}
            (label :text "" :style "color: #${scheme[b]};")
        )
      )
      (label :text {scheme.scheme} :style "color: #${scheme["foreground"]};" :class "scheme-name" :halign "center" :hexpand true)
    )
    (box
      :class "body"
      :spacing 8
      :orientation "v"
      :space-evenly false
      :valign "start"
      :halign "fill"
      :vexpand true
      :hexpand true
      (scheme_preview_heading
        :text "Author(s)"
        :text_col "#${scheme["foreground"]}"
        :star_col "#${scheme[scheme.accent]}"
      )
      (label 
        :class "author-name" 
        :style "color: #${scheme["foreground"]}; margin-bottom: 12px;" 
        :valign "start"
        :halign "start"
        :vexpand true
        :hexpand true
        :truncate true
        :text {scheme.author}
      )
      (scheme_preview_heading
        :text "Palette"
        :text_col "#${scheme["foreground"]}"
        :star_col "#${scheme[scheme.accent]}"
      )
      (box
        :class "scheme-colours"
        :halign "fill"
        :style "margin-bottom: 12px;"
        ;:style "background-color: transparentize(#${scheme["foreground"]}, 0.9);"
        (box
          :spacing 8
          :orientation "h"
          :halign "center"
          :hexpand true
          (for c in scheme_cols
            (colour
              :hex "#${scheme[c]}"
              :border {c == "background" ? "#${scheme["foreground"]}" : "rgba(0, 0, 0, 0)"}
            )
          )
        )
      )
      (stack 
        :selected {current_scheme == "${scheme["id"]}" ? 1 : 0}
        (button
          :onclick "(yzconf colourscheme '${scheme["id"]}' && ${EWW_CMD} update settings_menu_item=1 && yzwidgets open settings) &"
          :css "button {background-color: transparentize(#${scheme["foreground"]}, 0.9); &:hover {background: transparentize(#${scheme["foreground"]}, 0.8);}}"
          (label 
            :text "Select scheme" 
            :style "color: #${scheme["foreground"]};"
          )
        )
        (label
          :style "color: transparentize(#${scheme["foreground"]}, 0.7); font-style: italic;"
          :class "selected-text"
          :text "(selected)"
        )
      )
    )
  )  
)

(defwidget scheme_box [colourschemes polarity empty]
  (box 
    :class "colours-box-outer ${polarity}"
    ;:style "background-image: url('${current_wallpaper}');"
    :style "background-image: url('${colourschemes_bg_image}');"
    :width 530
    (scroll
      :hscroll false
      :vscroll true
      :class "colours-scroller"
      (box
        :class "colours-box"
        :orientation "v"
        :space-evenly false
        :spacing 8
        (box
            :class "no-schemes-found"
            :visible empty
            (label :text "No schemes found...")
        )
        (for scheme in colourschemes
          (scheme_preview :scheme scheme)
        )
      )
    )
  )
)

(defwidget scheme_polarity_buttons []
  (box
    :orientation "h"
    :space-evenly false
    :spacing 8
    :halign "center"
    :hexpand true
    (button
      :class "polarity-button ${schemes_selected == 0 ? "selected" : ""}"
      :onclick "${EWW_CMD} update schemes_selected=0"
      (label :text "Dark")
    )
    (button
      :class "polarity-button ${schemes_selected == 1 ? "selected" : ""}"
      :onclick "${EWW_CMD} update schemes_selected=1"
      (label :text "Light")
    )
  )
)

(defwidget colourschemes []
  (box
    :class "colourschemes"
    :orientation "v"
    :space-evenly false
    :spacing 8
    :halign "fill"
    (overlay
      :halign "fill"
      (input 
        :value scheme_query
        :halign "fill"
        :onchange "${EWW_CMD} update scheme_query='{}'; settings/scripts/schemes.py '{}' &"
      )
      (label 
        :text "Filter... " 
        :class "filter-label" 
        :halign "start" 
        :hexpand true
        :visible {scheme_query == "" ? true : false}
      )
    )
    (stack
      :selected schemes_selected
      :transition {schemes_selected == 0 ? "slideleft" : "slideright"}
      :same-size true
      (scheme_box
        :colourschemes dark_colourschemes
        :polarity "dark"
        :visible {dark_colourschemes == '{"window_buttons": ["red", "yellow", "green"]}' ? false : true}
        :empty no_dark_schemes_found
      )
      (scheme_box
        :colourschemes light_colourschemes
        :polarity "light"
        :visible {light_colourschemes == `{"window_buttons": ["red", "yellow", "green"]}` ? false : true}
        :empty no_light_schemes_found
      )
    )
    (scheme_polarity_buttons)
  )
)
