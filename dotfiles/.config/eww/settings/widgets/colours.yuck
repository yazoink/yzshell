(defwidget colour [hex]
  (button
    :onclick "wl-copy '${hex}'; notify-send '${hex}' 'Copied to clipboard.'"
    :class "colour"
    :style "background-color: ${hex}"
    :tooltip "${hex} (click to copy)"
    (box
      :width 24
      :height 24
    )
  )
)

(defwidget scheme_preview [scheme]
  (box
    :class "scheme-preview"
    :space-evenly false
    :orientation "v"
    :halign "center"
    :hexpand true
    :width 300
    :style `
      background-color: #${scheme["background"]}; 
      border: 1px solid transparentize(#${scheme["foreground"]}, 0.9);
      margin-left: ${scheme["offset-x"]}px;
      margin-top: ${scheme["offset-y"]}px;`
    (overlay
      :class "header"
      :halign "fill"
      (box
        :class "window-buttons"
        :halign "start"
        :hexpand true
        :spacing 8
        (for b in {scheme.window_buttons}
            (label :text "" :style "color: #${scheme[b]};")
        )
      )
      (label 
        :text {scheme.id} 
        :style "color: #${scheme["foreground"]};" 
        :class "scheme-name" 
        :halign "center" 
        :hexpand true
      )
    )
    (box
      :class "body"
      :spacing 8
      :orientation "v"
      :space-evenly false
      :valign "start"
      :halign "fill"
      (box
        :orientation "h"
        :space-evenly false
        (label
          :text {scheme.scheme}
          :halign "start"
          :hexpand true
          :style "color: #${scheme["foreground"]}; font-weight: bold; font-size: 15pt; margin: 8px;"
        )
        (stack 
          :halign "end"
          :hexpand true
          :valign "center"
          :hexpand true
          :style "margin-right: 8px;"
          :selected {current_scheme == "${scheme["id"]}" ? 1 : 0}
          (button
            :onclick `
              (
                yzwidgets close all
                yzconf colourscheme '${scheme["id"]}'
                yzwidgets open settings
              ) &`
            :css ` 
              button {
                background-color: transparentize(#${scheme["foreground"]}, 0.9); 
                &:hover {
                  background: transparentize(#${scheme["foreground"]}, 0.8);
                }
              }`
            (label 
              :text "Apply scheme" 
              :style "color: #${scheme["foreground"]};"
            )
          )
          (label
            :style `
              color: transparentize(#${scheme["foreground"]}, 0.7); 
              font-style: italic;`
            :class "selected-text"
            :text "(selected)"
          )
        )
      )
      (box
        :class "info-box"
        :orientation "v"
        :halign "fill"
        :space-evenly false
        :spacing 8
        :style `background-color: transparentize(#${scheme["foreground"]}, 0.9);`
        (label
          ;:class "mono"
          :halign "start"
          :hexpand true
          :style "color: #${scheme[scheme.accent]}; font-weight: bold; font-size: 13pt;"
          :text "Author(s)"
        )
        (label
          ;:class "mono"
          :halign "start"
          :hexpand true
          :text {scheme.author}
          :style "color: #${scheme["foreground"]}; "
          :wrap-mode "char"
          :limit-width 40
          :lines 10
          :wrap true
          :truncate true
        )
      )
      (box
        :class "info-box"
        :orientation "v"
        :halign "fill"
        :space-evenly false
        :spacing 8
        :style `background-color: transparentize(#${scheme["foreground"]}, 0.9);`
        (label
          ;:class "mono"
          :halign "start"
          :hexpand true
          :style "color: #${scheme[scheme.accent]}; font-weight: bold; font-size: 13pt;"
          :text "Palette"
        )
        (box
          :class "scheme-colours"
          :halign "start"
          :hexpand false
          :style "margin-bottom: 12px;"
          ;:style "background-color: transparentize(#${scheme["foreground"]}, 0.9);"
          (box
            :spacing 8
            :orientation "h"
            :halign "center"
            :hexpand true
            (for c in scheme_cols
              (colour :hex "#${scheme[c]}")
            )
          )
        )
      )
    )
  )  
)

(defwidget scheme_box [colourschemes polarity]
  (box 
    :class "colours-box-outer ${polarity}"
    ;:style "background-image: url('${current_wallpaper}');"
    :style "background-image: url('${colourschemes_bg_image}');"
    (overlay
      (scroll
        :hscroll false
        :vscroll true
        :class "colours-scroller"
        :width 530
        :height 450
        (stack
          :selected {no_schemes_found ? 0 : 1}
          (label :text "No results found..." :class "not-found")
          (box
            :class "colours-box"
            :orientation "v"
            :space-evenly false
            :spacing 8
            (for scheme in colourschemes
              (scheme_preview :scheme scheme)
            )
          )
        )
      )
      (next_prev_buttons
        :next_cmd "$YZSHELL_EWW_SCRIPT_DIR/schemes.py --page=next --query='${scheme_query}' --polarity=${schemes_selected == 0 ? "dark" : "light"} &"
        :prev_cmd "$YZSHELL_EWW_SCRIPT_DIR/schemes.py --page=prev --query='${scheme_query}' --polarity=${schemes_selected == 0 ? "dark" : "light"} &"
      )
      (search_bar
        :halign "center"
        :valign "start"
        :value scheme_query
        :icon ""
        :width 420
        :placeholder "Search..."
        :onchange `
            ${EWW_CMD} update scheme_query='{}'
            $YZSHELL_EWW_SCRIPT_DIR/schemes.py --query='{}' --page=0 &`
        :onaccept ""
      )
    )
  )
)

(defwidget scheme_polarity_buttons []
  (box
    :orientation "h"
    :space-evenly false
    :spacing 4
    :halign "end"
    :hexpand true
    :valign "center"
    :vexpand true
    :class "scheme-polarity-buttons"
    (button
      :class "polarity-button ${schemes_selected == 0 ? "selected" : ""}"
      :onclick `
        (
            $YZSHELL_EWW_SCRIPT_DIR/schemes.py --polarity=dark --page=0 --query='${scheme_query}'
            ${EWW_CMD} update schemes_selected=0
        ) &`
      (label :text "Dark")
    )
    (button
      :class "polarity-button ${schemes_selected == 1 ? "selected" : ""}"
      :onclick `
        (
            $YZSHELL_EWW_SCRIPT_DIR/schemes.py --polarity=light --page=0 --query='${scheme_query}'
            ${EWW_CMD} update schemes_selected=1
        ) &`
      (label :text "Light")
    )
  )
)

(defwidget colourschemes []
  (box
    :class "colourschemes"
    :orientation "v"
    :space-evenly false
    :spacing 8
    :halign "fill"
    :valign "end"
    :vexpand true
    (box
      :orientation "h"
      :space-evenly false
      (heading :size "large" :text "Colourscheme")
      (scheme_polarity_buttons)
    )
    (stack
      :selected schemes_selected
      :transition {schemes_selected == 0 ? "slideleft" : "slideright"}
      :same-size true
      (scheme_box
        :colourschemes dark_colourschemes
        :polarity "dark"
        :visible {
          dark_colourschemes == '{"window_buttons": ["red", "yellow", "green"]}' 
          ? false : true
        }
      )
      (scheme_box
        :colourschemes light_colourschemes
        :polarity "light"
        :visible {
          light_colourschemes == `{"window_buttons": ["red", "yellow", "green"]}` 
          ? false : true
        }
      )
    )
    (label
      :style "opacity: 0.4; font-style: italic;"
      :limit-width 60
      :show-truncated true
      :halign "start"
      :hexpand true
      :text "Current: ${current_scheme}"
      :tooltip current_scheme
    )
  )
)
