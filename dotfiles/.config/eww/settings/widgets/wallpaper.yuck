;(defpoll wallpapers :run-while settings_visible :interval "15s" "yzwidgets ctl settings_update_available_wallpapers")
(defvar wallpaper_dir "")
;(defpoll wallpaper_dir :run-while settings_visible :interval "72h" "yzconf get wallpaper_dir")
(defvar wallpapers "[]")
(defvar current_wallpaper "")
(defvar wallpaper_mode "")

(defwidget fill_buttons []
  (box
    :space-evenly false
    :spacing 8
    :orientation "h"
    :halign "center"
    :hexpand true
    (button 
      :onclick "yzconf wallpaper mode 'stretch' &" 
      :class "fill-button${wallpaper_mode == "stretch" ? " selected" : ""}"
      "Stretch"
    )
    (button 
      :onclick "yzconf wallpaper mode 'fit' &" 
      :class "fill-button${wallpaper_mode == "fit" ? " selected" : ""}"
      "Fit"
    )
    (button 
      :onclick "yzconf wallpaper mode 'fill' &"
      :class "fill-button${wallpaper_mode == "fill" ? " selected" : ""}"
      "Fill"
    )
    (button 
      :onclick "yzconf wallpaper mode 'center' &" 
      :class "fill-button${wallpaper_mode == "center" ? " selected" : ""}"
      "Center"
    )
    (button 
      :onclick "yzconf wallpaper mode 'tile' &" 
      :class "fill-button${wallpaper_mode == "tile" ? " selected" : ""}"
      "Tile"
    )
  )
)

(defwidget wallpaper []
  (box
    :class "wp-box"
    :orientation "v"
    :space-evenly false
    :spacing 8
    (box
      :space-evenly false
      :spacing 8
      :orientation "h"
      (label :text "Directory:")
      (input 
        :value wallpaper_dir 
        :onaccept "yzwidgets ctl settings_update_available_wallpapers -d '{}' &" 
        :halign "fill"
        :hexpand true
      )
    )
    (scroll
      :vscroll true
      :hscroll false
      :class "wp-scroller"
      (box
        :class "wp-button-box"
        :orientation "v"
        :spacing 8
        :space-evenly false
        (label :class "loading" :text "Loading..." :visible {wallpapers == "[]" ? true : false})
        (for row in wallpapers
          (box
            :orientation "h"
            :spacing 8
            :halign "center"
            :hexpand true
            (for wallpaper in row
                (button
                  :onclick "yzconf wallpaper image '${wallpaper_dir}/${wallpaper}' &"
                  :class "wallpaper-button${current_wallpaper == "${wallpaper_dir}/${wallpaper}" ? " selected" : ""}"
                  :tooltip wallpaper
                  (box
                    :orientation "v"
                    :valign "center"
                    :spacing 8
                    :space-evenly false
                    (image :path "/tmp/wallpaper_cache/${wallpaper}" :image-width 150)
                    ;(label :text "${wallpaper_dir}/${wallpaper}")
                    (label
                      :text wallpaper 
                      ;:truncate true 
                      :limit-width 10
                    )
                  )
                )
            )
          )
        )
      )
    )
    (fill_buttons)
  )
)
