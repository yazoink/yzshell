(defwidget fill_button [text mode]
  (button 
    :onclick "yzconf wallpaper mode '${mode}' &" 
    :class "fill-button${wallpaper_mode == mode ? " selected" : ""}"
    text
  )
)

(defwidget fill_buttons []
  (box
    :space-evenly false
    :spacing 8
    :orientation "h"
    :halign "center"
    :hexpand true
    (fill_button :text "Stretch" :mode "stretch")
    (fill_button :text "Fit" :mode "fit")
    (fill_button :text "Fill" :mode "fill")
    (fill_button :text "Center" :mode "center")
    (fill_button :text "Tile" :mode "tile")
  )
)

(defwidget wallpaper []
  (box
    :class "wp-box"
    :orientation "v"
    :space-evenly false
    :spacing 8
    (box
      :space-evenly false
      :spacing 8
      :orientation "h"
      (label :text "Directory:")
      (input 
        :value wallpaper_dir 
        :onaccept "$YZSHELL_EWW_SCRIPT_DIR/wallpapers.py -d '{}' &"
        :halign "fill"
        :hexpand true
      )
      (button
        :onclick `
          $YZSHELL_EWW_SCRIPT_DIR/wallpapers.py -r -d '${wallpaper_dir}' & 
          $YZSHELL_EWW_SCRIPT_DIR/schemes_background.py &`
        :tooltip "Reload wallpapers"
        (label 
          :text "" 
          :class "blue" 
          :style `
            font-weight: bold; 
            font-family: 'Font Awesome 7 Free';
            margin: 2px;`
        )
      )
    )
    (scroll
      :vscroll true
      :hscroll false
      :class "wp-scroller"
      (box
        :class "wp-button-box"
        :orientation "v"
        :spacing 8
        :space-evenly false
        (stack
          :visible {wallpapers == "[]" ? true : false}
          :selected {wallpapers_loading ? 1 : 0}
          (label
            :class "loading" 
            :text "No images found..." 
          )
          (label
            :class "loading" 
            :text "Loading..." 
          )
        )
        (for row in wallpapers
          (box
            :orientation "h"
            :spacing 8
            :halign "center"
            :hexpand true
            (for wallpaper in row
                (button
                  :onclick "yzconf wallpaper image '${wallpaper_dir}/${wallpaper}' &"
                  :class "wallpaper-button${current_wallpaper == "${wallpaper_dir}/${wallpaper}" ? " selected" : ""}"
                  :tooltip wallpaper
                  (box
                    :orientation "v"
                    :valign "center"
                    :spacing 8
                    :space-evenly false
                    (image 
                        :path "${get_env("YZSHELL_WALLPAPER_CACHE_DIR")}/${wallpaper}" 
                        :image-width 150
                    )
                    (label
                      :text wallpaper 
                      ;:truncate true 
                      :limit-width 10
                    )
                  )
                )
            )
          )
        )
      )
    )
    (fill_buttons)
  )
)
