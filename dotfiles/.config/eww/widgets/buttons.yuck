; size: "extra-small", "small", "medium", "large"
(defwidget icon_button [icon tooltip command size colour ?class ?style]
    (button
        :onclick command
        :tooltip tooltip
        :style style
        :class "icon icon-button icon-button-${size} ${colour} ${class}"
        icon
    )
)

(defwidget menu_button [name colour tooltip icon index curr_selected menu_var]
  (button
    :class "menu-button ${curr_selected == index ? "selected" : ""}"
    :onclick "$YZSHELL_EWW_SCRIPT_DIR/slide.py ${curr_selected} ${index} ${menu_var}"
    :tooltip tooltip
    (box
      :orientation "h"
      :space-evenly false
      (label :text icon :class "icon menu-button-icon ${colour}")
      (revealer
        :transition stack_transition
        :reveal {curr_selected == index ? true : false}
        (label :text name)
      )
    )
  )
)

(defwidget dropdown [label onchange items ?style]
  (overlay
    :style style
    (box
        :class "combo-box-format"
        (label :text "${label}  ")
    )
    (combo-box-text
        :class "combo-box"
        :items items
        :onchange onchange
    )
  )
)