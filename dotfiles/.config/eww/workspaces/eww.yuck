(defvar workspaces_visible false)
(defvar workspaces_width 225)
(defvar workspaces_height 125)
(defpoll workspaces 
    :interval "3s" 
    :initial "[]" 
    :run-while workspaces_visible
    "workspaces/scripts/workspaces.py"
)
(defvar active_workspace 0)

(defwidget workspaces_scroll []
    (scroll
        :class "workspaces-scroll"
        :hscroll false
        :vscroll true
        :height workspaces_height
        :width workspaces_width
        (box
            :class "workspaces-box"
            :orientation "v"
            :spacing 8
            (for w in workspaces
                (button
                    :class "workspace-button ${active_workspace == "${w["name"]}" ? "selected" : ""}"
                    ;:visible {"${w["name"]}" == "special:special" ? false : true}
                    :height 125
                    :onclick 
                        `eww poll workspaces
                        hyprctl dispatch 'hl.dsp.focus({workspace = ${w["id"]}})' & 
                        yzwidgets close all &`
                    "${w["name"]}"
                )
            )
        )
    )
)

(defwindow workspaces
    :monitor 0 
    :geometry (geometry 
        :x "4px"
        :y "4px"
        :anchor "bottom left"
    )
    :stacking "fg"
    :exclusive false
    :focusable false
    (box
        :class "workspaces"
        (workspaces_scroll)
    )
)
