{
    "hyprland/workspaces": {
        "format": "",
        "tooltip": true,
        "show-special": false,
        "all-outputs": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
        "persistent-workspaces": {
            "*": 6
        },
        "tooltips": {
            "default": "Workspace {name}",
            "empty": "" // Will result in no tooltip
        }
    }
}