{
    "ext/workspaces": {
        "format": "",
        "on-click": "activate",
        "sort-by-name": true,
        "tooltip": true,
        "all-outputs": false,
        "tooltip-format": "Mod + 1-9, or scroll to switch workspaces",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'"
    }
}