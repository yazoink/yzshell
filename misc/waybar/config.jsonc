{
  "reload_style_on_change": false,
  "layer": "top",
  "exclusive": true,
  "position": "bottom",
  "spacing": 4,
  "height": 50,
  "modules-left": [
    "custom/menu",
    "group/workspaces-group"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "group/quick-access-slider",
    "clock"
  ],
  "custom/menu": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open control panel (Mod+Ctrl+M)",
    "on-click": "yzwidgets toggle control_center"
  },
  "ext/workspaces": {
    "on-click": "activate",
    "sort-by-name": true,
    "active-only": true,
    "tooltip": true,
    "tooltip-format": "Mod + 1-5, or scroll to switch workspaces",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
    "format": "Workspace {name}"
  },
  "custom/workspaces": {
    "tooltip": true,
    "tooltip-format": "Switch workspaces",
    "format": "",
    "on-click": "yzwidgets toggle workspaces",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'"
  },
  "group/workspaces-group": {
    "orientation": "inherit",
    "modules": [
      "custom/workspaces",
      "ext/workspaces"
    ]
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "icon-theme": "Papirus",
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close"
  },
  "group/quick-access": {
    "orientation": "inherit",
    "modules": [
      "network",
      "group/volume-expander"
    ]
  },
  "custom/left-arrow": {
    "format": "",
    "tooltip": false
  },
  "group/quick-access-slider": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 1000,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/left-arrow",
      "group/quick-access",
      "tray"
    ]
  },
  "group/volume-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "wireplumber#icon",
      "wireplumber#volume"
    ]
  },
  "wireplumber#icon": {
    "format": "{icon}",
    "format-muted": "",
    "on-click": "$(yzconf get terminal) -e alsamixer",
    "on-click-right": "amixer -D pipewire set Master toggle",
    "tooltip-format": "Volume\n- Right click to mute\n- Click to open settings\n- Scroll to adjust",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "hands-free": "󰋋",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "wireplumber#volume": {
    "on-click": "$(yzconf get terminal) -e alsamixer",
    "on-click-right": "amixer -D pipewire set Master toggle",
    "format": "{volume}%",
    "format-muted": "{volume}%"
  },
  "network": {
    "format-wifi": "<span font='13' rise='3000'>{icon}</span>",
    "format-ethernet": "",
    "format-linked": "󱘖",
    "format-disconnected": "󰤣",
    "format-disabled": "󰤮",
    "on-click": "$(yzconf get terminal) -e nmtui",
    "on-click-right": "$(yzconf get terminal) -e nmtui",
    "on-scroll-up": "nmcli radio wifi on",
    "on-scroll-down": "nmcli radio wifi off",
    "tooltip-format-disconnected": "No Connection",
    "tooltip-format-disabled": "Wi-Fi is OFF",
    "tooltip-format-wifi": "󱄙  {essid} ({signalStrength}%)\n\n󰐻  Freq: {frequency}GHz\n  {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀  {ifname} (Connected)\n  {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-linked": "󱘖 {ifname}: No IP Address",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },
  "bluetooth": {
    "format": "<span font='13' rise='3000'>󰂯</span>",
    "format-connected": "<span font='13' rise='3000'>󰂱</span>",
    "format-disabled": "<span font='13' rise='3000'>󰂲</span>",
    "tooltip-format": "{controller_alias} {status}",
    "tooltip-format-connected": "󰐻  {num_connections} Connected:\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "󰂱  {device_alias} (󰠠  {device_battery_percentage}%)",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth"
  },
  "group/battery-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "battery#icon",
      "battery#percentage"
    ]
  },
  "battery#icon": {
    "bat": "BAT0",
    "interval": 60,
    "tooltip-format": "Battery",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format": "{icon}",
    "format-charging": ""
  },
  "battery#percentage": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%"
  },
  "group/backlight-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/backlight-icon",
      "backlight"
    ]
  },
  "custom/backlight-icon": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Backlight (scroll to adjust)"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}%",
    "tooltip": true,
    "tooltip-format": "Backlight (scroll to adjust)"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 4
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "on-click": "yzwidgets toggle calendar",
    "tooltip": true,
    "tooltip-format": "Open calendar (Mod+Shift+C)"
  }
}
