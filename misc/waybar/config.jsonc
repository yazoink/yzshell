{
  "reload_style_on_change": false,
  "layer": "top",
  "exclusive": true,
  "position": "bottom",
  "spacing": 4,
  "height": 50,
  "modules-left": [
    "custom/menu",
    "group/workspaces-group"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "group/quick-access-slider",
    "clock"
  ],
  "custom/menu": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open control panel (Mod+Ctrl+M)",
    "on-click": "yzwidgets toggle control_center"
  },
  "ext/workspaces": {
    "on-click": "activate",
    "sort-by-name": true,
    "active-only": true,
    "tooltip": true,
    "tooltip-format": "Mod + 1-5, or scroll to switch workspaces",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
    "format": "Workspace {name}"
  },
  "custom/workspaces": {
    "tooltip": true,
    "tooltip-format": "Switch workspaces",
    "format": "",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/workspaces.xml",
    "menu-actions": {
      "w-1": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })",
      "w-2": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })",
      "w-3": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })",
      "w-4": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })",
      "w-5": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })",
      "w-6": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })",
      "w-7": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"7\" })",
      "w-8": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"8\" })",
      "w-9": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"9\" })"
    }
  },
  "group/workspaces-group": {
    "orientation": "inherit",
    "modules": [
      "custom/workspaces",
      "ext/workspaces"
    ]
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "icon-theme": "Papirus",
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close"
  },
  "group/quick-access": {
    "orientation": "inherit",
    "modules": [
      "group/volume-expander",
      "group/tray-expander"
    ]
  },
  "custom/left-arrow": {
    "format": "",
    "tooltip": false
  },
  "group/quick-access-slider": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 1000,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/left-arrow",
      "group/quick-access"
    ]
  },
  "group/volume-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "wireplumber#icon",
      "wireplumber#volume"
    ]
  },
  "wireplumber#icon": {
    "format": "{icon}",
    "format-muted": "",
    "on-click-right": "pavucontrol",
    "on-click-middle": "amixer -D pipewire set Master toggle",
    "on-click": "amixer -D pipewire set Master toggle",
    "tooltip-format": "Volume\\n- Click to mute\\n- Right click to open settings\\n- Scroll to adjust",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "wireplumber#volume": {
    "on-click-right": "pavucontrol-qt",
    "on-click-middle": "amixer -D pipewire set Master toggle",
    "on-click": "amixer -D pipewire set Master toggle",
    "format": "{volume}%",
    "format-muted": "{volume}%"
  },
  "group/battery-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "battery#icon",
      "battery#percentage"
    ]
  },
  "battery#icon": {
    "bat": "BAT0",
    "interval": 60,
    "tooltip-format": "Battery",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format": "{icon}",
    "format-charging": ""
  },
  "battery#percentage": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%"
  },
  "group/backlight-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/backlight-icon",
      "backlight"
    ]
  },
  "custom/backlight-icon": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Backlight (scroll to adjust)"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}%",
    "tooltip": true,
    "tooltip-format": "Backlight (scroll to adjust)"
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/tray-icon",
      "tray"
    ]
  },
  "custom/tray-icon": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Systray"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 4
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "on-click": "yzwidgets toggle calendar",
    "tooltip": true,
    "tooltip-format": "Open calendar (Mod+Shift+C)"
  }
}
