(defvar menu_visible true)
(defvar control_center_visible false)

(defvar user_input "")
(defvar search_results "[]")
(defvar search_selected -1)
(defpoll update_results :interval "15m" :initial "" "yzshell update_search_cache")

(include "control_center/widgets/top_menu/top_menu.yuck")
(include "control_center/widgets/launchers.yuck")
(include "control_center/widgets/user.yuck")
(include "control_center/widgets/search.yuck")

(defwindow search_input
  :monitor 0
  :geometry (geometry
    :x 13
    :y 13
    :anchor "bottom left"
  )
  :windowtype "dialog"
  :stacking "fg"
  :exclusive false
  :focusable true
  (box
    :orientation "h"
    :space-evenly false
    :halign "fill"
    :class "search-bar"
    :spacing 8
    (label :text "" :class "icon search" :halign "start")
    (input ; search bar
      :value user_input 
      :onchange "yzshell get_search_results '{}' &"
      :onaccept "control_center/scripts/search_confirm.sh &"
      :halign "fill"
      :hexpand true
    )
  )
)

(defwindow control_center
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom left"
  )
  :windowtype "dialog"
  :stacking "fg"
  :exclusive false
  :focusable false
  (revealer
    :transition "slideup"
    :reveal control_center_visible
    (box
      :space-evenly false
      (label :text update_results :visible false)
      (box
        :orientation "vertical"
        :space-evenly false
        :spacing 4
        (control_center_menu)
        (box
          :class "control-center-box"
          :orientation "vertical"
          :halign "fill"
          :space-evenly false
          :spacing 8
          (user)
          (box
            :class "control-center-body"
            :orientation "horizontal"
            :space-evenly "false"
            :halign "fill"
            :valign "start"
            :spacing 8
            ;(apps)
            (search)
            (launchers)
          )
        )
      )
    )
  )
)
