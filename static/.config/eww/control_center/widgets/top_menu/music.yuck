(defpoll song :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "playerctl metadata title || echo 'n/a'")
(defpoll song_artist :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "playerctl metadata artist || echo 'n/a'")
(defpoll song_status :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "control_center/scripts/get_player_status.sh")
(defpoll cover_art :run-while {menu_item == 0 && control_center_visible} :interval "3s"  "control_center/scripts/get_album_cover.sh")

(defwidget music []
  (box
    :class "music-box"
    :orientation "h"
    :space-evenly false
    :spacing 8
    (box
      :class "album-cover"
      :vexpand "false" 
      :hexpand "false" 
      :style "background-image: url('${cover_art}');"
    )
    (box
      :orientation "v"
      :class "music-info-controls"
      :halign "center"
      :valign "center"
      :hexpand true
      :space-evenly false
      :tooltip "Open music player"
      (button
        :onclick "yzshell close control_center & exec audacious &"
        (box
          :class "music-info"
          :orientation "v"
          :halign "center"
          :valign "center"
          :hexpand true
          :space-evenly false
          (label 
            :class "song"
            :text "${song}" 
            :wrap true 
            ;:wrap-mode "word"
            :limit-width 25
            ;:lines 3 
            :justify "center"
          )
          (label 
            :class "artist"
            :text "${song_artist}" 
            :wrap false 
            :justify "center"
          )
        )
      )
      (box
        :class "controls"
        :orientation "h"
        :spacing 4
        :halign "center"
        :hexpand true
        (button :class "prev" :onclick "control_center/scripts/player.sh previous" "")
        (button :class "toggle" :onclick "control_center/scripts/player.sh play-pause" song_status)
        (button :class "next" :onclick "control_center/scripts/player.sh next" "")
      )
    )
  )
)
