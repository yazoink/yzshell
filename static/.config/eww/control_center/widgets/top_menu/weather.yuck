(defpoll weather_updater :interval "15m" "yzshell update_weather &")
(defvar weather_temp "n/a")
(defvar weather_apparent_temp "n/a")
(defvar weather_icon "n/a")
(defvar weather_tz "n/a")
(defvar weather_colour "n/a")

(defwidget weather []
  (box
    :class "weather-box"
    :orientation "v"
    :space-evenly false
    :halign "fill"
    (label :text weather_tz :class "timezone")
    (box
      :orientation "h"
      :space-evenly false
      :halign "center"
      :hexpand true
      (label :text weather_icon :class "icon ${weather_colour}")
      (label :text weather_updater :visible false)
      (box
        :class "temp-apparent-temp"
        :orientation "v"
        :valign "center"
        :space-evenly false
        :halign "center"
        :hexpand true
        (label :text weather_temp :class "temp")
        (label :text weather_apparent_temp :class "apparent_temp")
      )
    )
  )
)
