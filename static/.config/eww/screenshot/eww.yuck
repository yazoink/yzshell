(defvar screenshot_visible false)
(defvar output "")

(defwindow screenshot
  :monitor 0
  :geometry (geometry
    :x 4
    :y 4
    :anchor "bottom center"
  )
  :stacking "fg"
  :exclusive false
  :focusable "ondemand"
  (box
    :orientation "h"
    :class "screenshot-box"
    :space-evenly false
    :vexpand false
    :spacing 8
    (input
      :value output
      :onchange "${EWW_CMD} update output='{}'"
      :tooltip "Save to"
    )
    (box
      :orientation "h"
      :class "screenshot-buttons-box"
      :space-evenly false
      :vexpand false
      :valign "end"
      :spacing 8
      (button
        :onclick "yzshell close_all_widgets & yzshell screenshot -m 'full' -o '${output}' -s 0.5 &"
        :tooltip "Take a fullscreen screenshot"
        (label :text "" :class "icon screenshot-full")
      )
      (button
        :onclick "yzshell closeall_widgets & yzshell screenshot -m 'select' -o '${output}' -s 0.5 &"
        :tooltip "Take a selective screenshot"
        (label :text "" :class "icon screenshot-select")
      )
      (button
        :onclick "yzshell close_all_widgets &"
        :tooltip "Cancel"
        (label :text "" :class "icon screenshot-cancel")
      )
    )
  )
)
