{
  "reload_style_on_change": false,
  "layer": "top",
  "exclusive": true,
  "position": "bottom",
  "spacing": 4,
  "height": 50,
  "modules-left": [
    "custom/menu",
    "group/workspaces-group"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "group/quick-access-slider",
    "clock"
  ],
  "custom/menu": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open start menu (Mod+P)",
    "on-click": "yzwidgets open control_center"
  },
  "ext/workspaces": {
    "on-click": "activate",
    "sort-by-name": true,
    "active-only": true,
    "tooltip": true,
    "tooltip-format": "Mod + 1-5, or scroll to switch workspaces",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
    "format": "Workspace {name}"
  },
  "custom/workspaces": {
    "tooltip": true,
    "tooltip-format": "Switch workspaces",
    "format": "",
    "on-click": "yzwidgets open workspaces",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'"
  },
  "group/workspaces-group": {
    "orientation": "inherit",
    "modules": [
      "custom/workspaces",
      "ext/workspaces"
    ]
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "icon-theme": "Papirus",
    "all-outputs": true,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close"
  },
  "group/quick-access": {
    "orientation": "inherit",
    "modules": [
      "group/volume-expander"
      {{#bar_show_battery}}
      ,"group/battery-expander"
      {{/bar_show_battery}}
      {{#bar_show_backlight}}
      ,"group/backlight-expander"
      {{/bar_show_backlight}}
    ]
  },
  "custom/left-arrow": {
    "format": "",
    "tooltip": false
  },
  "group/quick-access-slider": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 1000,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/left-arrow",
      "group/quick-access",
      "tray"
    ]
  },
  "group/volume-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "wireplumber#icon",
      "wireplumber#volume"
    ]
  },
  "wireplumber#icon": {
    "format": "{icon}",
    "format-muted": "",
    "on-click": "{{terminal}} -e alsamixer",
    "on-click-right": "amixer -D pipewire set Master toggle",
    "tooltip-format": "Volume\n- Right click to mute\n- Click to open settings\n- Scroll to adjust",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "hands-free": "󰋋",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "wireplumber#volume": {
    "on-click": "{{terminal}} -e alsamixer",
    "on-click-right": "amixer -D pipewire set Master toggle",
    "format": "{volume}%",
    "format-muted": "{volume}%"
  },
  "group/battery-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "battery#icon",
      "battery#percentage"
    ]
  },
  "battery#icon": {
    "bat": "BAT0",
    "interval": 60,
    "tooltip-format": "Battery",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format": "{icon}",
    "format-charging": ""
  },
  "battery#percentage": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%"
  },
  "group/backlight-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/backlight-icon",
      "backlight"
    ]
  },
  "custom/backlight-icon": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Backlight (scroll to adjust)"
  },
  "backlight": {
    "format": "{percent}%",
    "tooltip": true,
    "tooltip-format": "Backlight (scroll to adjust)"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "on-click": "yzwidgets open calendar",
    "tooltip": true,
    "tooltip-format": "Open calendar (Mod+Shift+C)"
  }
}
