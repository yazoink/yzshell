 /* Common variables affecting all pages */
@-moz-document url-prefix("about:") {
    :root {
    --in-content-page-color: #{{foreground}} !important;
    --color-accent-primary: #{{blue}} !important;
    --color-accent-primary-hover: #{{blue}} !important;
    --color-accent-primary-active: #{{blue}} !important;
    background-color: #{{background}} !important;
    --in-content-page-background: #{{background}} !important;
    }
}

/* Variables and styles specific to about:newtab and about:home */
@-moz-document url("about:newtab"), url("about:home") {

    :root {
    --newtab-background-color: #{{background}} !important;
    --newtab-background-color-secondary: #{{surface2}} !important;
    --newtab-element-hover-color: #{{surface2}} !important;
    --newtab-text-primary-color: #{{foreground}} !important;
    --newtab-wordmark-color: #{{foreground}} !important;
    --newtab-primary-action-background: #{{blue}} !important;
    }

    .icon {
    color: #{{blue}} !important;
    }

    .search-wrapper .logo-and-wordmark .logo {
    display: inline-block !important;
    height: 82px !important;
    width: 82px !important;
    background-size: 82px !important;
    }

    @media (max-width: 609px) {
    .search-wrapper .logo-and-wordmark .logo {
        background-size: 64px !important;
        height: 64px !important;
        width: 64px !important;
    }
    }

    .card-outer:is(:hover, :focus, .active):not(.placeholder) .card-title {
    color: #{{blue}} !important;
    }

    .top-site-outer .search-topsite {
    background-color: #{{blue}} !important;
    }

    .compact-cards .card-outer .card-context .card-context-icon.icon-download {
    fill: #{{green}} !important;
    }
}

/* Variables and styles specific to about:preferences */
@-moz-document url-prefix("about:preferences") {
    :root {
    --zen-colors-tertiary: #{{surface1}} !important;
    --in-content-text-color: #{{foreground}} !important;
    --link-color: #{{blue}} !important;
    --link-color-hover: #{{blue}} !important;
    --zen-colors-primary: #{{surface2}} !important;
    --in-content-box-background: #{{surface2}} !important;
    --zen-primary-color: #{{blue}} !important;
    }

    groupbox , moz-card{
    background: #{{background}} !important;
    }

    button,
    groupbox menulist {
    background: #{{surface2}} !important;
    color: #{{foreground}} !important;
    }

    .main-content {
    background-color: #{{background}} !important;
    }

    .identity-color-blue {
    --identity-tab-color: #{{blue}} !important;
    --identity-icon-color: #{{blue}} !important;
    }

    .identity-color-turquoise {
    --identity-tab-color: #{{cyan}} !important;
    --identity-icon-color: #{{cyan}} !important;
    }

    .identity-color-green {
    --identity-tab-color: #{{green}} !important;
    --identity-icon-color: #{{green}} !important;
    }

    .identity-color-yellow {
    --identity-tab-color: #{{yellow}} !important;
    --identity-icon-color: #{{yellow}} !important;
    }

    .identity-color-orange {
    --identity-tab-color: #{{orange}} !important;
    --identity-icon-color: #{{orange}} !important;
    }

    .identity-color-red {
    --identity-tab-color: #{{red}} !important;
    --identity-icon-color: #{{red}} !important;
    }

    .identity-color-pink {
    --identity-tab-color: #{{purple}} !important;
    --identity-icon-color: #{{purple}} !important;
    }

    .identity-color-purple {
    --identity-tab-color: #{{brown}} !important;
    --identity-icon-color: #{{brown}} !important;
    }
}

/* Variables and styles specific to about:addons */
@-moz-document url-prefix("about:addons") {
    :root {
    --zen-dark-color-mix-base: #{{surface1}} !important;
    --background-color-box: #{{background}} !important;
    }
}

/* Variables and styles specific to about:protections */
@-moz-document url-prefix("about:protections") {
    :root {
    --zen-primary-color: #{{background}} !important;
    --social-color: #{{purple}} !important;
    --coockie-color: #{{blue}} !important;
    --fingerprinter-color: #{{yellow}} !important;
    --cryptominer-color: #{{brown}} !important;
    --tracker-color: #{{green}} !important;
    --in-content-primary-button-background-hover: #{surface3} !important;
    --in-content-primary-button-text-color-hover: #{{foreground}} !important;
    --in-content-primary-button-background: #{surface3} !important;
    --in-content-primary-button-text-color: #{{foreground}} !important;
    }

    .card {
    background-color: #{{surface2}} !important;
    }
}

::selection {
    background-color: #{{surface2}} !important;
    color: #{{foreground}} !important;
}